{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AdVideoDb": ""
  },
  "AdVideo": {
    "Storage": {
      "Provider": "Minio",
      "ServiceUrl": "http://localhost:9000",
      "AccessKey": "",
      "SecretKey": "",
      "Region": "us-east-1",
      "LocalRoot": "App_Data/advideo-storage"
    },
    "Ffmpeg": {
      "FfmpegPath": "ffmpeg",
      "FfprobePath": "ffprobe",
      "TimeoutSeconds": 300,
      "Threads": 0
    },
    "FakeProviders": {
      "Enabled": false
    }
  }
}
