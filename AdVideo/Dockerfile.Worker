# Worker — chạy pipeline. Đây là image DUY NHẤT cần FFmpeg và cần font có dấu tiếng Việt.
#
# Build từ thư mục AdVideo/:
#   docker build -f Dockerfile.Worker -t advideo-worker .

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY Directory.Build.props ./
COPY src/AdVideo.Core/AdVideo.Core.csproj src/AdVideo.Core/
COPY src/AdVideo.Infrastructure/AdVideo.Infrastructure.csproj src/AdVideo.Infrastructure/
COPY src/AdVideo.Worker/AdVideo.Worker.csproj src/AdVideo.Worker/

RUN dotnet restore src/AdVideo.Worker/AdVideo.Worker.csproj

COPY src/ src/

RUN dotnet publish src/AdVideo.Worker/AdVideo.Worker.csproj \
    -c Release \
    -o /app \
    --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final

# ffmpeg: bước 6 và bước 8 gọi thẳng nhị phân này, không có binding nào thay thế.
# fonts-dejavu-core + fontconfig: drawtext vẽ nhãn AI và mọi chữ trên hình (D4). DejaVu Sans có
#   đủ dấu tiếng Việt — quan trọng vì drawtext KHÔNG báo lỗi khi font thiếu glyph, nó vẽ ô vuông,
#   và lỗi chỉ lộ ra khi có người mở video thành phẩm ra xem.
# curl: cho HEALTHCHECK.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        fontconfig \
        fonts-dejavu-core \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -f

# Cùng lý do với image API: volume thừa hưởng quyền của thư mục này lúc được tạo lần đầu.
# API và Worker phải dùng CHUNG một key ring, nếu không worker không giải mã nổi API key mà API
# vừa ghi — và thông báo lỗi lúc đó nói về payload hỏng chứ không nói gì về key ring.
RUN mkdir -p /var/lib/advideo/keys && chown -R app:app /var/lib/advideo

WORKDIR /app
COPY --from=build /app ./

USER app

EXPOSE 5081

# Tự dò trong PATH. Ghi nguyên đường dẫn ở đây thì một bản ffmpeg cài chỗ khác sẽ làm worker
# chết ngay lúc khởi động — FfmpegOptions.Validate() kiểm tra file có thật.
ENV AdVideo__Ffmpeg__FfmpegPath=ffmpeg \
    AdVideo__Ffmpeg__FfprobePath=ffprobe \
    AdVideo__Ffmpeg__FontFile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf \
    Urls=http://+:5081

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=10 \
    CMD curl -fsS http://localhost:5081/healthz || exit 1

ENTRYPOINT ["dotnet", "AdVideo.Worker.dll"]
