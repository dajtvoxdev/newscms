@page
@{
    ViewData["Title"] = "Không có quyền truy cập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>403 — Không có quyền</title>
    <style>
        body { font-family: system-ui, sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; background: #f8fafc; color: #1e293b; }
        .box { text-align: center; padding: 2rem; }
        h1 { font-size: 4rem; font-weight: 800; margin: 0; color: #ef4444; }
        p { color: #64748b; margin: .5rem 0 1.5rem; }
        a { display: inline-block; padding: .6rem 1.4rem; background: #1e293b; color: #fff; border-radius: .5rem; text-decoration: none; font-weight: 600; }
        a:hover { background: #334155; }
    </style>
</head>
<body>
    <div class="box">
        <h1>403</h1>
        <p>Bạn không có quyền truy cập trang này.</p>
        <a href="/Admin">Về trang quản trị</a>
    </div>
</body>
</html>
