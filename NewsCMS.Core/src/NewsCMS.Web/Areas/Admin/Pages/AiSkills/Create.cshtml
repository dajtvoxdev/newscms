@page
@model NewsCMS.Web.Areas.Admin.Pages.AiSkills.CreateModel
@{
    ViewData["Title"] = "Thêm kỹ năng AI";
}

<div class="mb-6 flex items-center justify-between">
    <h2 class="text-2xl font-extrabold tracking-tight text-slate-950">Thêm kỹ năng AI</h2>
    <a asp-area="Admin" asp-page="/AiSkills/Index" class="admin-btn-secondary">Quay lại</a>
</div>

<form method="post" class="admin-card max-w-2xl space-y-5 p-6">
    <div asp-validation-summary="ModelOnly" class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"></div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
            <label class="admin-label">Key *</label>
            <input asp-for="Input.Key" class="admin-input mt-1" placeholder="my_skill" required pattern="[a-z0-9_]+" />
            <p class="mt-1 text-xs text-slate-400">Chỉ chữ thường, số và gạch dưới.</p>
        </div>
        <div>
            <label class="admin-label">Tên hiển thị *</label>
            <input asp-for="Input.Name" class="admin-input mt-1" required />
        </div>
    </div>
    <div>
        <label class="admin-label">Mô tả</label>
        <textarea asp-for="Input.Description" rows="2" class="admin-input mt-1"></textarea>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
            <label class="admin-label">Loại *</label>
            <select asp-for="Input.Kind" class="admin-select mt-1" id="skillKind" onchange="toggleFields()">
                <option value="0">Prompt</option>
                <option value="1">Tool</option>
            </select>
        </div>
        <div>
            <label class="admin-label">Thứ tự</label>
            <input asp-for="Input.SortOrder" type="number" class="admin-input mt-1" value="0" />
        </div>
    </div>

    <!-- Prompt fields -->
    <div id="promptFields" class="space-y-5">
        <div>
            <label class="admin-label">System Prompt</label>
            <textarea asp-for="Input.SystemPrompt" rows="3" class="admin-input mt-1"></textarea>
        </div>
        <div>
            <label class="admin-label">User Prompt Template</label>
            <textarea asp-for="Input.UserPromptTemplate" rows="3" class="admin-input mt-1"
                      placeholder="Placeholder: {title}, {content}, {selection}, {language}, {styleInstruction}"></textarea>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            <div>
                <label class="admin-label">Temperature</label>
                <input asp-for="Input.Temperature" type="number" step="0.1" min="0" max="2" class="admin-input mt-1" />
            </div>
            <div>
                <label class="admin-label">Max Tokens</label>
                <input asp-for="Input.MaxTokens" type="number" class="admin-input mt-1" />
            </div>
            <div>
                <label class="admin-label">Targets</label>
                <input asp-for="Input.Targets" class="admin-input mt-1" placeholder="post.body,post.excerpt" />
                <p class="mt-1 text-xs text-slate-400">Phân cách bằng dấu phẩy. Hỗ trợ: <code class="text-xs">post.title</code>, <code class="text-xs">post.body</code>, <code class="text-xs">post.excerpt</code>, <code class="text-xs">product.name</code>, <code class="text-xs">product.description</code>, <code class="text-xs">product.short</code></p>
            </div>
        </div>
        <div class="flex items-center gap-6">
            <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
                <input asp-for="Input.AllowStyled" type="checkbox" class="h-4 w-4" />
                Cho phép Styled
            </label>
            <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
                <input asp-for="Input.UseTools" type="checkbox" class="h-4 w-4" />
                Sử dụng Tools
            </label>
        </div>
    </div>

    <!-- Tool fields -->
    <div id="toolFields" style="display:none" class="space-y-5">
        <div>
            <label class="admin-label">Tool Type *</label>
            <select asp-for="Input.ToolType" class="admin-select mt-1">
                <option value="">-- Chọn tool --</option>
                @foreach (var tool in Model.ToolOptions)
                {
                    <option value="@tool.Key">@tool.DisplayName - @tool.Description</option>
                }
            </select>
        </div>
        <div>
            <label class="admin-label">Base URL</label>
            <input asp-for="Input.BaseUrl" class="admin-input mt-1" placeholder="https://api.firecrawl.dev" />
        </div>
        <div>
            <label class="admin-label">API Key</label>
            <input asp-for="Input.ApiKey" type="password" class="admin-input mt-1" />
        </div>
        <div>
            <label class="admin-label">Config JSON</label>
            <textarea asp-for="Input.ConfigJson" rows="2" class="admin-input mt-1" placeholder='{"key":"value"}'></textarea>
        </div>
    </div>

    <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
        <input asp-for="Input.IsActive" type="checkbox" class="h-4 w-4" />
        Kích hoạt
    </label>

    <div class="flex gap-2">
        <button type="submit" class="admin-btn-primary">Tạo kỹ năng</button>
        <a asp-area="Admin" asp-page="/AiSkills/Index" class="admin-btn-secondary">Huỷ</a>
    </div>
</form>

@section Scripts {
<script>
function toggleFields() {
    const kind = document.getElementById('skillKind').value;
    document.getElementById('promptFields').style.display = kind === '0' ? '' : 'none';
    document.getElementById('toolFields').style.display = kind === '1' ? '' : 'none';
}
</script>
}
