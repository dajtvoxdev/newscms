@page "{id:guid}"
@model DeleteModel
@{
    ViewData["Title"] = "Xoá trải nghiệm AR";
}

<div class="mb-6">
    <p class="text-sm font-semibold text-red-600">Trải nghiệm AR</p>
    <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-950">Xác nhận xoá</h2>
</div>

<div class="admin-card p-6">
    <p class="text-slate-700">Bạn có chắc muốn xoá trải nghiệm AR sau không?</p>
    <p class="mt-3 font-bold text-slate-950">@Model.Item!.Title</p>
    <p class="font-mono text-sm text-slate-500">/ar/@Model.Item.Slug</p>
    <p class="mt-2 text-xs text-slate-500">Hành động này ẩn trải nghiệm khỏi public (soft delete). Dữ liệu vẫn được giữ trong database.</p>

    <form method="post" class="mt-6 flex gap-3">
        @Html.AntiForgeryToken()
        <button type="submit" class="admin-btn-danger">Xác nhận xoá</button>
        <a asp-page="/ArExperiences/Details" asp-route-id="@Model.Id" class="admin-btn-secondary">Huỷ</a>
    </form>
</div>
