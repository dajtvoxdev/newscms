@page
@using NewsCMS.Application.KeoBia
@model IndexModel
@{
    ViewData["Title"] = "Người chơi Kèo Bia";
}

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="text-sm font-semibold text-indigo-600">Kèo Bia 2026</p>
        <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-950">Tracking người chơi</h2>
    </div>
    <a href="/Admin/KeoBia/Matches" class="admin-btn-secondary">Lịch & kết quả</a>
</div>

@if (TempData["Success"] is string msg)
{
    <div class="hidden">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="hidden">@err</div>
}

<form method="get" class="admin-card mb-6 grid gap-3 p-4 md:grid-cols-[1fr_140px]">
    <input class="admin-input" name="q" value="@Model.Keyword" placeholder="Tìm theo tên hoặc public key..." />
    <button class="admin-btn-secondary" type="submit">Lọc</button>
</form>

<form method="post" asp-page-handler="BulkAddStar" class="admin-card mb-6 flex flex-wrap items-center gap-3 p-4">
    <span class="text-sm font-bold text-slate-700">Thêm nhanh cho tất cả:</span>
    <input type="hidden" name="q" value="@Model.Keyword" />
    <button type="submit" name="starType" value="hope" class="inline-flex items-center gap-1 rounded-lg bg-amber-100 px-3 py-1.5 text-xs font-bold text-amber-700 hover:bg-amber-200">@AdminIcon.Svg("star") +1 Hi vọng</button>
    <button type="submit" name="starType" value="devil" class="inline-flex items-center gap-1 rounded-lg bg-purple-100 px-3 py-1.5 text-xs font-bold text-purple-700 hover:bg-purple-200">@AdminIcon.Svg("skull") +1 Ma quỷ</button>
</form>

<form method="post" asp-page-handler="RejournalCupLogs" class="mb-6" data-confirm="Xóa toàn bộ CupLog per-match và tái tạo lại?" data-confirm-danger="true">
    <input type="hidden" name="q" value="@Model.Keyword" />
    <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg bg-red-100 px-3 py-1.5 text-xs font-bold text-red-700 hover:bg-red-200">@AdminIcon.Svg("refresh-cw") Tái tạo CupLog (fix balanceAfter)</button>
</form>

<div class="keobia-players-layout">
    <div class="admin-card overflow-x-auto" role="region" aria-label="Danh sách người chơi" tabindex="0">
        <table class="keobia-players-table w-full text-left text-sm">
            <thead class="sticky top-0 z-10 bg-slate-100/95 text-[11px] font-bold uppercase tracking-wide text-slate-600 shadow-sm backdrop-blur">
                <tr>
                    <th class="px-4 py-3">Người chơi</th>
                    <th class="px-3 py-3 text-center">Kèo</th>
                    <th class="px-3 py-3 text-center">Đã dự đoán</th>
                    <th class="px-3 py-3 text-center">Đúng/Sai</th>
                    <th class="px-3 py-3 text-center">Đang thiếu</th>
                    <th class="px-3 py-3 text-center">Miễn miss</th>
                    <th class="px-3 py-3 text-center">Giảm nợ</th>
                    <th class="px-3 py-3 text-center">Đã tặng</th>
                    <th class="px-3 py-3 text-center">@AdminIcon.Svg("star") Hi vọng</th>
                    <th class="px-3 py-3 text-center">@AdminIcon.Svg("skull") Ma quỷ</th>
                    <th class="px-4 py-3">Lần cuối</th>
                    <th class="px-4 py-3 text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (Model.Items.Items.Count == 0)
                {
                    <tr><td colspan="12" class="px-5 py-10 text-center text-slate-500">Chưa có người chơi nào.</td></tr>
                }
                @foreach (var item in Model.Items.Items)
                {
                    <tr class="@(item.IsBlocked ? "opacity-60" : "") odd:bg-white even:bg-slate-50/60 transition-colors hover:bg-indigo-50/50">
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-2.5">
                                @if (!string.IsNullOrWhiteSpace(item.AvatarUrl))
                                {
                                    <img src="@item.AvatarUrl" alt="" class="h-9 w-9 rounded-full object-cover ring-1 ring-slate-200" />
                                }
                                else
                                {
                                    <div class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-amber-200 to-amber-100 text-xs font-bold uppercase text-amber-700">@(string.IsNullOrWhiteSpace(item.DisplayName) ? "?" : item.DisplayName.Trim().Substring(0, 1))</div>
                                }
                                <div>
                                    <div class="font-bold text-slate-950 text-sm">
                                        @item.DisplayName
                                        @if (item.IsBlocked)
                                        {
                                            <span class="ml-1 inline-block rounded-full bg-red-100 px-1.5 py-0.5 text-[9px] font-bold text-red-600">@(item.StoppedPlayingAt.HasValue ? "ĐÃ DỪNG" : "BLOCK")</span>
                                        }
                                    </div>
                                    @if (item.StoppedPlayingAt.HasValue)
                                    {
                                        <div class="mt-0.5 text-[10px] font-semibold text-amber-700">Dừng lúc @item.StoppedPlayingAt.Value.ToLocalTime().ToString("dd/MM HH:mm")</div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3 text-center font-semibold">@item.TotalBets</td>
                        <td class="px-4 py-3 text-center text-xs font-semibold">
                            <div class="keobia-player-unit inline-flex items-center gap-1 text-amber-700">@AdminIcon.Svg("beer") @item.TotalBeerCups cốc bia</div>
                            <div class="keobia-player-unit mt-1 inline-flex items-center gap-1 text-orange-700">@AdminIcon.Svg("peanut") @item.TotalPeanutPacks gói lạc</div>
                        </td>
                        <td class="px-4 py-3 text-center text-slate-600">@item.CorrectBets/@item.WrongBets</td>
                        <td class="px-4 py-3 text-center text-xs font-semibold">
                            <div class="keobia-player-unit inline-flex items-center gap-1 text-amber-700">@AdminIcon.Svg("beer") @item.OutstandingBeerCups cốc bia</div>
                            <div class="keobia-player-unit mt-1 inline-flex items-center gap-1 text-orange-700">@AdminIcon.Svg("peanut") @item.OutstandingPeanutPacks gói lạc</div>
                        </td>
                        <td class="px-3 py-3 text-center">
                            <form method="post" asp-page-handler="AddMissedCredit" class="inline-flex items-center gap-1 rounded-full border border-slate-200 bg-white px-1 py-0.5 shadow-sm">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="q" value="@Model.Keyword" />
                                <input type="hidden" name="p" value="@Model.CurrentPage" />
                                <input type="number" name="cups" min="1" max="999" value="1" class="h-7 w-14 rounded-full border border-slate-200 px-2 text-center text-xs font-bold text-slate-700" />
                                <button type="submit" title="Miễn phạt do bỏ lỡ trận" class="flex h-7 w-7 items-center justify-center rounded-full font-bold text-emerald-600 transition hover:bg-emerald-50">+</button>
                                <span class="keobia-player-miss-balance text-left text-[10px] font-extrabold leading-tight tabular-nums">
                                    <span class="block text-amber-700">@Html.Raw(AdminIcon.Tag("beer")) @item.MissedCreditBeerCups cốc bia</span>
                                    <span class="mt-0.5 block text-orange-700">@Html.Raw(AdminIcon.Tag("peanut")) @item.MissedCreditPeanutPacks gói lạc</span>
                                </span>
                            </form>
                        </td>
                        <td class="px-3 py-3 text-center">
                            <form method="post" asp-page-handler="AddBalanceCredit" class="inline-flex items-center gap-1 rounded-full border border-slate-200 bg-white px-1 py-0.5 shadow-sm">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="q" value="@Model.Keyword" />
                                <input type="hidden" name="p" value="@Model.CurrentPage" />
                                <input type="number" name="cups" min="1" max="999" value="2" class="h-7 w-14 rounded-full border border-slate-200 px-2 text-center text-xs font-bold text-slate-700" />
                                <button type="submit" title="Giảm phần đang thiếu, ưu tiên cốc bia cũ" class="flex h-7 w-7 items-center justify-center rounded-full font-bold text-emerald-600 transition hover:bg-emerald-50">−</button>
                            </form>
                        </td>
                        <td class="px-4 py-3 text-center text-xs font-semibold">
                            <div class="keobia-player-unit inline-flex items-center gap-1 text-amber-700">@AdminIcon.Svg("beer") @item.SharedBeerCups cốc bia</div>
                            <div class="keobia-player-unit mt-1 inline-flex items-center gap-1 text-orange-700">@AdminIcon.Svg("peanut") @item.SharedPeanutPacks gói lạc</div>
                        </td>
                        <td class="px-3 py-3 text-center">
                            <form method="post" asp-page-handler="UpdateStars" class="inline-flex items-center gap-0.5 rounded-full border border-slate-200 bg-white px-1 py-0.5 shadow-sm">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="q" value="@Model.Keyword" />
                                <input type="hidden" name="p" value="@Model.CurrentPage" />
                                <button type="submit" name="action" value="hope-minus" title="Bớt 1" class="flex h-7 w-7 items-center justify-center rounded-full font-bold text-red-600 transition hover:bg-red-50">−</button>
                                <span class="w-7 text-center text-sm font-extrabold tabular-nums @(item.HopeStars < 0 ? "text-red-600" : "text-amber-600")">@item.HopeStars</span>
                                <button type="submit" name="action" value="hope-plus" title="Thêm 1" class="flex h-7 w-7 items-center justify-center rounded-full font-bold text-emerald-600 transition hover:bg-emerald-50">+</button>
                            </form>
                        </td>
                        <td class="px-3 py-3 text-center">
                            <form method="post" asp-page-handler="UpdateStars" class="inline-flex items-center gap-0.5 rounded-full border border-slate-200 bg-white px-1 py-0.5 shadow-sm">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="q" value="@Model.Keyword" />
                                <input type="hidden" name="p" value="@Model.CurrentPage" />
                                <button type="submit" name="action" value="devil-minus" title="Bớt 1" class="flex h-7 w-7 items-center justify-center rounded-full font-bold text-red-600 transition hover:bg-red-50">−</button>
                                <span class="w-7 text-center text-sm font-extrabold tabular-nums @(item.DevilStars < 0 ? "text-red-600" : "text-purple-600")">@item.DevilStars</span>
                                <button type="submit" name="action" value="devil-plus" title="Thêm 1" class="flex h-7 w-7 items-center justify-center rounded-full font-bold text-emerald-600 transition hover:bg-emerald-50">+</button>
                            </form>
                        </td>
                        <td class="whitespace-nowrap px-4 py-3 text-xs text-slate-500">@item.LastSeenAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                        <td class="px-4 py-3 text-right">
                            <form method="post" asp-page-handler="ToggleBlock" class="inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="block" value="@(item.IsBlocked ? "false" : "true")" />
                                <input type="hidden" name="q" value="@Model.Keyword" />
                                <input type="hidden" name="p" value="@Model.CurrentPage" />
                                @if (item.IsBlocked)
                                {
                                    <button type="submit" class="rounded-md bg-emerald-100 px-2.5 py-1 text-[11px] font-bold text-emerald-700 transition hover:bg-emerald-200">Mở khoá</button>
                                }
                                else
                                {
                                    <button type="submit" class="rounded-md bg-red-100 px-2.5 py-1 text-[11px] font-bold text-red-700 transition hover:bg-red-200"
                                            data-confirm-button="Dừng người chơi này? Các kèo chưa diễn ra sẽ bị huỷ.">Khoá</button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <aside class="admin-card p-5">
        <h3 class="text-base font-extrabold text-slate-950">Kèo vừa chốt</h3>
        <div class="mt-4 space-y-3">
            @if (Model.RecentBets.Items.Count == 0)
            {
                <div class="rounded-xl bg-slate-50 p-4 text-sm text-slate-500">Chưa có hoạt động.</div>
            }
            @foreach (var bet in Model.RecentBets.Items)
            {
                <div class="rounded-xl border border-slate-100 p-3">
                    <div class="font-bold text-slate-900">@bet.PlayerName</div>
                    <div class="mt-1 text-sm text-slate-600">@KeoBiaUnitRules.FormatCount(bet.Cups, bet.UnitCode) cho <b>@bet.ChoiceLabel</b></div>
                    <div class="mt-1 text-xs text-slate-400">@bet.MatchLabel · @bet.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</div>
                </div>
            }
        </div>
    </aside>
</div>

@if (Model.Items.TotalPages > 1)
{
    <div class="mt-4 flex gap-2">
        @for (int i = 1; i <= Model.Items.TotalPages; i++)
        {
            <a asp-page="/KeoBia/Players/Index" asp-route-q="@Model.Keyword" asp-route-p="@i"
               class="admin-btn-secondary @(i == Model.CurrentPage ? "font-bold" : "")">@i</a>
        }
    </div>
}
