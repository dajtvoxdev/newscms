@page
@model NewsCMS.Web.Areas.Admin.Pages.Builder.ApiKeysModel
@{
    ViewData["Title"] = "API key cho agent";
    var mcpHost = Model.HttpContext.Request.Host.Value;
}

<div class="mb-6">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-indigo-600">Site Builder</p>
    <h2 class="text-xl font-bold text-slate-900 mt-1">API key cho agent / MCP</h2>
    <p class="mt-2 max-w-3xl text-sm text-slate-500">
        Key dùng để agent AI kết nối tới endpoint <code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs">/mcp</code>
        và dựng site. Mỗi key chỉ thao tác được đúng site đã gắn — không thể trỏ sang site khác.
    </p>
</div>

<div asp-validation-summary="All" class="mb-4 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"></div>
@* Validation summary giữ nguyên dạng banner vì lỗi form cần thấy ngay tại chỗ; toast cho các trạng thái khác. *@

@if (Model.CreatedPlainKey is not null)
{
    <div class="mb-6 rounded-xl border-2 border-emerald-300 bg-emerald-50 p-5 shadow-sm">
        <div class="flex items-start gap-3">
            <span class="text-emerald-600">@AdminIcon.Svg("key-round", "h-7 w-7")</span>
            <div class="min-w-0 flex-1">
                <p class="font-semibold text-emerald-900">Đã tạo key '@Model.CreatedKeyName'</p>
                <p class="mt-1 text-sm text-emerald-800">
                    Key được lưu mã hoá — sau này xem lại được bất cứ lúc nào bằng nút
                    <strong>Xem key</strong> trong danh sách bên dưới.
                </p>
                <div class="mt-3 flex items-center gap-2">
                    <input id="newApiKey" type="text" readonly value="@Model.CreatedPlainKey"
                           class="admin-input flex-1 font-mono text-xs" />
                    <button type="button" onclick="copyApiKey()" class="admin-btn-secondary whitespace-nowrap">
                        Sao chép
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="grid gap-6 lg:grid-cols-[360px_1fr]">
    <!-- Tạo key mới -->
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h3 class="font-semibold text-slate-900">Tạo key mới</h3>

        <form method="post" asp-page-handler="Create" class="mt-4 space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="mb-1.5 block text-sm font-medium text-slate-700">Tên key</label>
                <input asp-for="Input.Name" class="admin-input w-full" placeholder="Claude Code — máy trạm" />
            </div>

            <div>
                <label class="mb-1.5 block text-sm font-medium text-slate-700">Phạm vi (scope)</label>
                <div class="space-y-2">
                    @foreach (var scope in Model.AvailableScopes)
                    {
                        <label class="flex items-start gap-2 text-sm text-slate-600">
                            <input type="checkbox" name="Input.Scopes" value="@scope"
                                   class="mt-0.5 rounded border-slate-300"
                                   checked="@(scope == NewsCMS.Application.Builder.ApiKeyScopes.BuilderRead)" />
                            <span>
                                <span class="font-mono text-xs text-slate-800">@scope</span>
                                <span class="block text-xs text-slate-500">
                                    @switch (scope)
                                    {
                                        case NewsCMS.Application.Builder.ApiKeyScopes.BuilderRead:
                                            <text>Đọc schema, xuất spec, liệt kê, xem trước.</text>
                                            break;
                                        case NewsCMS.Application.Builder.ApiKeyScopes.BuilderWrite:
                                            <text>Tạo/sửa trang, layout, chuyên mục, token, menu.</text>
                                            break;
                                        case NewsCMS.Application.Builder.ApiKeyScopes.BuilderCode:
                                            <text>Sửa custom JS/CSS — tương đương chạy mã trên trình duyệt khách. Chỉ cấp khi thật cần.</text>
                                            break;
                                    }
                                </span>
                            </span>
                        </label>
                    }
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-700">Hết hạn sau (ngày)</label>
                    <input asp-for="Input.ExpiresInDays" type="number" min="0" class="admin-input w-full" />
                    <p class="mt-1 text-xs text-slate-400">0 = không hết hạn</p>
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-700">Giới hạn (lượt/phút)</label>
                    <input asp-for="Input.RateLimitPerMinute" type="number" min="1" class="admin-input w-full" />
                </div>
            </div>

            <button type="submit" class="admin-btn-primary w-full">Tạo key</button>
        </form>
    </div>

    <!-- Danh sách key -->
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="flex flex-col gap-3 border-b border-slate-100 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <form method="get" class="flex items-center gap-2">
                <label class="text-sm text-slate-500">Trạng thái</label>
                <select class="admin-select" name="status" onchange="this.form.submit()">
                    <option value="@ApiKeyStatusFilters.Active" selected="@(Model.StatusFilter == ApiKeyStatusFilters.Active || Model.StatusFilter is null)">
                        Còn lưu hành
                    </option>
                    <option value="@ApiKeyStatusFilters.Expired" selected="@(Model.StatusFilter == ApiKeyStatusFilters.Expired)">Hết hạn</option>
                    <option value="@ApiKeyStatusFilters.Revoked" selected="@(Model.StatusFilter == ApiKeyStatusFilters.Revoked)">Đã thu hồi</option>
                    <option value="@ApiKeyStatusFilters.All" selected="@(Model.StatusFilter == ApiKeyStatusFilters.All)">Tất cả</option>
                </select>
                <noscript><button type="submit" class="admin-btn-secondary">Lọc</button></noscript>
            </form>
            <p class="text-xs text-slate-400">@Model.Items.Count() key</p>
        </div>
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
                <tr>
                    <th class="px-4 py-3 font-semibold">Tên</th>
                    @if (Model.IsSuperAdmin)
                    {
                        <th class="px-4 py-3 font-semibold">Site</th>
                    }
                    <th class="px-4 py-3 font-semibold">Scope</th>
                    <th class="px-4 py-3 font-semibold">Hết hạn</th>
                    <th class="px-4 py-3 font-semibold">Dùng lần cuối</th>
                    <th class="px-4 py-3 font-semibold">Trạng thái</th>
                    <th class="px-4 py-3 font-semibold text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in Model.Items)
                {
                    var isExpired = item.ExpiresAt is { } exp && exp <= DateTime.UtcNow;
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="px-4 py-3 font-medium text-slate-900">@item.Name</td>
                        @if (Model.IsSuperAdmin)
                        {
                            <td class="px-4 py-3 text-slate-500">
                                @if (item.SiteId is { } sid && Model.SiteNames.TryGetValue(sid, out var siteName))
                                {
                                    @siteName
                                }
                                else
                                {
                                    <span class="text-xs font-medium text-violet-700">Root</span>
                                }
                            </td>
                        }
                        <td class="px-4 py-3">
                            <div class="flex flex-wrap gap-1">
                                @foreach (var scope in item.Scopes.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-[11px] text-slate-600">@scope</span>
                                }
                            </div>
                        </td>
                        <td class="px-4 py-3 text-slate-500">
                            @(item.ExpiresAt?.ToString("dd/MM/yyyy") ?? "—")
                        </td>
                        <td class="px-4 py-3 text-slate-500">
                            @(item.LastUsedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa dùng")
                        </td>
                        <td class="px-4 py-3">
                            @if (item.IsRevoked)
                            {
                                <span class="inline-flex items-center gap-1 text-red-700">
                                    <span class="h-2 w-2 rounded-full bg-red-500"></span> Đã thu hồi
                                </span>
                            }
                            else if (isExpired)
                            {
                                <span class="inline-flex items-center gap-1 text-amber-700">
                                    <span class="h-2 w-2 rounded-full bg-amber-500"></span> Hết hạn
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 text-emerald-700">
                                    <span class="h-2 w-2 rounded-full bg-emerald-500"></span> Đang dùng
                                </span>
                            }
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="inline-flex items-center gap-2">
                                <button type="button" onclick="revealApiKey('@item.Id', this)"
                                        class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100">
                                    Xem key
                                </button>
                                @if (!item.IsRevoked)
                                {
                                    <form method="post" asp-page-handler="Revoke" asp-route-id="@item.Id"
                                          data-confirm="Thu hồi key này? Agent đang dùng sẽ mất quyền ngay." data-confirm-danger="true"
                                          class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100">
                                            Thu hồi
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="@(Model.IsSuperAdmin ? 7 : 6)" class="px-4 py-8 text-center text-slate-400">
                            @(Model.StatusFilter is null or ApiKeyStatusFilters.Active
                                ? "Chưa có key nào. Tạo key ở bên trái để agent kết nối được."
                                : "Không có key nào ở trạng thái này.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Hướng dẫn kết nối -->
<div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 p-5">
    <h3 class="font-semibold text-slate-900">Kết nối Claude Code vào site này</h3>
    <p class="mt-1 text-sm text-slate-500">Chạy lệnh sau, thay <code class="font-mono text-xs">&lt;KEY&gt;</code> bằng key vừa tạo:</p>
    <pre class="mt-3 overflow-x-auto rounded-lg bg-slate-900 p-4 text-xs leading-relaxed text-slate-100"><code>claude mcp add newscms --transport http https://@mcpHost/mcp --header "X-NewsCMS-Api-Key: &lt;KEY&gt;"</code></pre>
    <p class="mt-3 text-xs text-slate-400">
        Sau khi kết nối, bảo agent gọi <span class="font-mono">site_get_schema</span> trước để biết định dạng, rồi
        <span class="font-mono">site_apply</span> để dựng cả site trong một lần.
    </p>
</div>

@section Scripts {
    <script>
        function copyApiKey() {
            const input = document.getElementById('newApiKey');
            if (!input) return;
            input.select();
            navigator.clipboard.writeText(input.value).then(function () {
                window.toast?.success('Đã sao chép key vào clipboard.');
            }).catch(function () {
                window.toast?.error('Không sao chép được key.');
            });
        }

        // Lấy lại key thô từ server (đang lưu mã hoá DataProtection). Token anti-forgery
        // gửi qua header theo cấu hình HeaderName của app.
        async function revealApiKey(id, btn) {
            const row = btn.closest('tr');
            let target = row.querySelector('[data-revealed-key]');
            if (!target) {
                target = document.createElement('div');
                target.setAttribute('data-revealed-key', '');
                target.className = 'mt-3 flex items-center gap-2';
                row.querySelector('td').appendChild(target);
            }
            if (!target.hidden) { target.hidden = true; return; }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const res = await fetch(`?handler=RevealKey&id=${id}`, {
                    headers: { 'RequestVerificationToken': token || '' }
                });
                const data = await res.json();
                if (!data.key) {
                    window.toast?.error(data.error || 'Không lấy được key.');
                    return;
                }
                target.innerHTML =
                    '<input type="text" readonly class="admin-input flex-1 font-mono text-xs" value="' +
                    data.key.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;') + '" />' +
                    '<button type="button" class="admin-btn-secondary whitespace-nowrap">Sao chép</button>';
                target.querySelector('button').onclick = () => {
                    const input = target.querySelector('input');
                    input.select();
                    navigator.clipboard.writeText(input.value).then(function () {
                        window.toast?.success('Đã sao chép key vào clipboard.');
                    }).catch(function () {
                        window.toast?.error('Không sao chép được key.');
                    });
                };
                target.hidden = false;
            } catch {
                window.toast?.error('Không lấy được key.');
            }
        }
    </script>
}
