@page
@model NewsCMS.Web.Areas.Admin.Pages.Builder.IndexModel
@{
    ViewData["Title"] = "Builder Pages";
}

<div class="flex items-center justify-between mb-6">
    <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-indigo-600">Site Builder</p>
        <h2 class="text-xl font-bold text-slate-900 mt-1">Trang builder</h2>
    </div>
    <a asp-page="/Builder/Create" class="admin-btn-primary">+ Tạo trang mới</a>
</div>

<!-- Search -->
<form method="get" class="mb-4 flex gap-3">
    <input type="text" name="search" value="@Model.Search" placeholder="Tìm theo tiêu đề hoặc slug…"
           class="admin-input flex-1" />
    <button type="submit" class="admin-btn-secondary">Lọc</button>
    @if (!string.IsNullOrEmpty(Model.Search))
    {
        <a asp-page="/Builder/Index" class="admin-btn-secondary">Xoá lọc</a>
    }
</form>

<!-- Table -->
<div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
                <th class="px-4 py-3 font-semibold">Tiêu đề</th>
                <th class="px-4 py-3 font-semibold">Slug</th>
                <th class="px-4 py-3 font-semibold">Loại</th>
                <th class="px-4 py-3 font-semibold">Trạng thái</th>
                <th class="px-4 py-3 font-semibold">Version</th>
                <th class="px-4 py-3 font-semibold text-right">Thao tác</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            @foreach (var item in Model.TreeItems)
            {
                <tr class="hover:bg-slate-50/80 transition-colors @(item.Level > 0 ? "bg-slate-50/40" : "")">
                    <td class="px-4 py-3 font-medium text-slate-900" style="padding-left: @(item.Level * 28 + 16)px">
                        <div class="flex items-center gap-1.5">
                            @if (item.Level > 0)
                            {
                                <span class="text-slate-400 font-mono text-xs select-none">└─</span>
                            }
                            <span>@item.Page.Title</span>
                            @if (item.Page.IsDefaultTemplate)
                            {
                                <span class="inline-flex items-center rounded bg-amber-50 px-1.5 py-0.5 text-[10px] font-bold text-amber-700 border border-amber-200" title="Template dự phòng mặc định toàn site">Mặc định</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(item.ParentTitle))
                        {
                            <div class="text-[11px] text-slate-400 mt-0.5 pl-5">Trang cha: @item.ParentTitle</div>
                        }
                    </td>
                    <td class="px-4 py-3 text-slate-500 font-mono text-xs">/@item.Page.Slug</td>
                    <td class="px-4 py-3">
                        @switch (item.Page.Kind)
                        {
                            case "PostTemplate":
                                <span class="inline-flex items-center rounded-full bg-purple-50 px-2.5 py-0.5 text-xs font-semibold text-purple-700 border border-purple-200">Template Bài viết</span>
                                break;
                            case "ProductTemplate":
                                <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-semibold text-indigo-700 border border-indigo-200">Template Sản phẩm</span>
                                break;
                            case "CategoryTemplate":
                                <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-semibold text-blue-700 border border-blue-200">Template Chuyên mục</span>
                                break;
                            case "Landing":
                                <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700 border border-emerald-200">Landing</span>
                                break;
                            default:
                                <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600 border border-slate-200">Trang tĩnh</span>
                                break;
                        }
                    </td>
                    <td class="px-4 py-3">
                        @if (item.Page.Status == "Published")
                        {
                            <span class="inline-flex items-center gap-1 text-emerald-700">
                                <span class="h-2 w-2 rounded-full bg-emerald-500"></span> Xuất bản
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 text-amber-700">
                                <span class="h-2 w-2 rounded-full bg-amber-500"></span> Nháp
                            </span>
                        }
                    </td>
                    <td class="px-4 py-3 text-slate-500">v@(item.Page.Version)</td>
                    <td class="px-4 py-3 text-right">
                        <div class="flex items-center justify-end gap-2">
                            @if (item.Level == 0 && (item.Page.Kind == "Landing" || item.Page.Kind == "Static"))
                            {
                                <a asp-page="/Builder/Create" asp-route-parentId="@item.Page.Id" asp-route-kind="PostTemplate"
                                   class="inline-flex items-center gap-1 rounded-lg border border-purple-200 bg-purple-50 px-2.5 py-1.5 text-xs font-semibold text-purple-700 hover:bg-purple-100"
                                   title="Thêm template chi tiết cho trang này">
                                    + Template
                                </a>
                            }
                            <a asp-page="/Builder/Edit" asp-route-id="@item.Page.Id"
                               class="rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-700 hover:bg-indigo-100">
                                @AdminIcon.Svg("pencil") Builder
                            </a>
                            <form method="post" asp-page="/Builder/Index" asp-page-handler="Delete"
                                  asp-route-id="@item.Page.Id"
                                  data-confirm="Xoá trang này?" data-confirm-danger="true"
                                  class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100">
                                    @AdminIcon.Svg("trash") Xoá
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="6" class="px-4 py-8 text-center text-slate-400">
                        Chưa có trang builder nào. Bấm "+ Tạo trang mới" để bắt đầu.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <div class="mt-4 flex items-center justify-center gap-2">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-page="/Builder/Index" asp-route-page="@i" asp-route-search="@Model.Search"
               class="rounded-lg px-3 py-1.5 text-sm font-medium @(i == Model.CurrentPage ? "bg-indigo-600 text-white" : "border border-slate-200 text-slate-600 hover:bg-slate-50")">
                @i
            </a>
        }
    </div>
}
