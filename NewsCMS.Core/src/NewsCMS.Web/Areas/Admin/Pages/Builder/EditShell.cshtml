@page "{id:guid}"
@model NewsCMS.Web.Areas.Admin.Pages.Builder.EditShellModel
@{
    Layout = null; // Full-screen builder — không dùng _AdminLayout
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shell · @Model.LayoutName</title>

    <link rel="stylesheet" href="~/lib/grapesjs/grapes.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/codemirror/codemirror.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/codemirror/theme/material-darker.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nc-builder.css" asp-append-version="true" />
    <style>
        html, body { margin: 0; height: 100%; overflow: hidden; }

        /* ── Topbar (giống Edit.cshtml để hai màn không lệch nhau) ───────── */
        .nc-topbar {
            height: 48px; display: flex; align-items: center; gap: 12px;
            padding: 0 16px; background: #0f172a; color: #e2e8f0;
            font-family: system-ui, sans-serif; font-size: 13px;
            border-bottom: 1px solid #1e293b; z-index: 10;
        }
        .nc-topbar a { color: #93c5fd; text-decoration: none; font-weight: 600; }
        .nc-topbar a:hover { text-decoration: underline; }
        .nc-topbar .nc-title { font-weight: 700; color: #fff; max-width: 280px;
                               overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .nc-topbar .nc-badge { background: #1e293b; padding: 2px 8px;
                               border-radius: 4px; font-size: 11px; color: #94a3b8; }
        .nc-topbar .nc-badge.warn { background: #422006; color: #fbbf24; }
        .nc-topbar .nc-spacer { flex: 1; }
        .nc-topbar .nc-actions { display: flex; align-items: center; gap: 8px; }
        .nc-btn {
            padding: 6px 12px; border-radius: 6px; background: #1e293b; color: #e2e8f0;
            border: 1px solid #334155; cursor: pointer; font-size: 12px;
            font-weight: 600; display: inline-flex; align-items: center; gap: 6px;
        }
        .nc-btn:hover { background: #334155; }
        .nc-btn-primary { background: #2563eb; border-color: #2563eb; color: #fff; }
        .nc-btn-primary:hover { background: #1d4ed8; }
        .nc-status { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #94a3b8; }
        .nc-status .dot { width: 8px; height: 8px; border-radius: 50%; background: #64748b; }
        .nc-status.saving .dot { background: #f59e0b; }
        .nc-status.saved .dot { background: #22c55e; }
        .nc-status.error .dot { background: #ef4444; }

        .nc-devices { display: flex; gap: 4px; }
        .nc-device {
            padding: 4px 8px; border-radius: 4px; background: transparent; color: #94a3b8;
            border: 1px solid #334155; cursor: pointer; font-size: 12px;
            display: inline-flex; align-items: center;
        }
        .nc-device.active { background: #334155; color: #fff; }

        #gjs { height: calc(100vh - 48px); }
        .gjs-pn-panels { font-size: 12px; }
        .gjs-block { font-size: 11px !important; padding: 8px !important; }
        .nc-btn .nc-icon { width: 15px; height: 15px; }

        .nc-am-bar { display: flex; gap: 8px; align-items: center; padding: 0 0 10px; }
        .nc-am-bar input {
            flex: 1; min-width: 0; padding: 6px 10px; border-radius: 6px; font-size: 12px;
            border: 1px solid rgba(255, 255, 255, .15); background: rgba(0, 0, 0, .2); color: #ddd;
        }
        .nc-am-bar input::placeholder { color: #8c8c8c; }
        .nc-am-bar button {
            padding: 6px 12px; border-radius: 6px; font-size: 12px; cursor: pointer;
            border: 1px solid rgba(255, 255, 255, .15); background: rgba(255, 255, 255, .08); color: #ddd;
        }
        .nc-am-bar button:disabled { opacity: .45; cursor: default; }
        .nc-am-bar .nc-am-info { font-size: 11px; color: #9a9a9a; white-space: nowrap; }
    </style>
</head>
<body>
    @Html.AntiForgeryToken()

    <div class="nc-topbar">
        <a href="/Admin/Builder/Layouts">&larr; Layout</a>
        <span class="nc-title">@Model.LayoutName</span>
        <span class="nc-badge">@Model.LayoutKey</span>
        @if (Model.IsDefault)
        {
            <span class="nc-badge warn" title="Sửa shell này là sửa header/footer của MỌI trang dùng nó">Áp cho mọi trang</span>
        }

        <div class="nc-devices">
            <button class="nc-device active" data-device="Desktop" title="1440px">@AdminIcon.Svg("monitor")</button>
            <button class="nc-device" data-device="Tablet" title="768px">@AdminIcon.Svg("tablet")</button>
            <button class="nc-device" data-device="Mobile" title="375px">@AdminIcon.Svg("smartphone")</button>
        </div>

        <div class="nc-spacer"></div>

        <div class="nc-status" id="nc-status">
            <span class="dot"></span><span id="nc-status-text">Sẵn sàng</span>
        </div>

        <div class="nc-actions">
            <a class="nc-btn" href="/" target="_blank" rel="noopener" title="Mở trang chủ ở tab mới">@AdminIcon.Svg("external-link") Xem site</a>
            <button class="nc-btn" id="btn-code" title="CSS/JS riêng của shell">@AdminIcon.Svg("code") Code</button>
            <button class="nc-btn nc-btn-primary" id="btn-save">@AdminIcon.Svg("save") Lưu shell</button>
        </div>
    </div>

    <div id="gjs"></div>

    <script src="~/lib/grapesjs/grapes.min.js" asp-append-version="true"></script>
    <script src="~/lib/grapesjs/nc-tailwind.js" asp-append-version="true"></script>
    <script src="~/lib/codemirror/codemirror.min.js" asp-append-version="true"></script>
    <script src="~/lib/codemirror/mode/css/css.min.js" asp-append-version="true"></script>
    <script src="~/lib/codemirror/mode/xml/xml.min.js" asp-append-version="true"></script>
    <script src="~/lib/codemirror/mode/javascript/javascript.min.js" asp-append-version="true"></script>
    <script src="~/lib/codemirror/mode/htmlmixed/htmlmixed.min.js" asp-append-version="true"></script>
    <script src="~/lib/codemirror/addon/edit/matchbrackets.min.js" asp-append-version="true"></script>
    <script src="~/lib/codemirror/addon/edit/closebrackets.min.js" asp-append-version="true"></script>
    <script src="~/js/admin/nc-realm-bridge.js" asp-append-version="true"></script>
    <script src="~/js/admin/nc-css-inspector.js" asp-append-version="true"></script>
    <!-- Beautify khi mở / minify khi lưu cho mọi editor code (csso/terser/js-beautify nạp lười). -->
    <script src="~/js/admin/nc-code-format.js" asp-append-version="true"></script>
    <script src="~/js/admin/nc-builder-extensions.js" asp-append-version="true"></script>
    <!-- Hạ tầng canvas dùng chung với màn sửa trang: hydrate preview, font Google, Asset Manager. -->
    <script src="~/js/admin/nc-builder-canvas.js" asp-append-version="true"></script>
    <div id="upload-tracker"></div>
    <script src="~/lib/tus/tus.min.js"></script>
    <script src="~/js/admin/upload-manager.js" asp-append-version="true"></script>

    <script>
        (function () {
            var LAYOUT_ID = '@Model.LayoutId';
            var LAYOUT_KEY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LayoutKey));
            var LAYOUT_NAME = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LayoutName));
            var LAYOUT_KIND = '@Model.Kind';
            var IS_DEFAULT = @((Model.IsDefault).ToString().ToLowerInvariant());
            var TOKEN_CSS_URL = '@Model.TokenCssUrl';
            var SITE_CUSTOM_CSS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SiteCustomCss));
            var SITE_CUSTOM_JS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SiteCustomJs));
            var SITE_HEAD_HTML = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SiteHeadHtml));
            var HAS_CODE_SCOPE = @((Model.HasCodeScope).ToString().ToLowerInvariant());
            var GOOGLE_FONTS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.GoogleFonts.Select(f => new { name = f.Name, category = f.Category, weights = f.Weights })));

            var TOKEN = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var API = '/admin/api/builder/layouts/' + LAYOUT_ID;

            /** Phần tử shell nơi nội dung từng trang được thế vào — khớp PageRenderer/SiteLayoutService. */
            var BODY_MARKER = 'data-nc-body';

            var statusEl = document.getElementById('nc-status');
            var statusText = document.getElementById('nc-status-text');

            function setStatus(state, text) {
                statusEl.className = 'nc-status ' + state;
                statusText.textContent = text;
            }

            function apiHeaders(json) {
                var h = { 'RequestVerificationToken': TOKEN };
                if (json) h['Content-Type'] = 'application/json';
                return h;
            }

            // ── Nạp shell từ server ──────────────────────────────────────────
            /**
             * true nếu shell đã có HTML lúc mở. Lưới an toàn giống Edit.cshtml: canvas rỗng mà cờ
             * này bật thì chặn lưu — shell hỏng làm sập header/footer của MỌI trang, không chỉ một.
             */
            var hadContentOnLoad = false;

            /**
             * CompiledHtml của shell là MẢNH THÂN (header/main/footer), không phải tài liệu đầy đủ:
             * ContentSanitizer.SanitizeBuilder loại &lt;!DOCTYPE&gt;/&lt;html&gt;/&lt;head&gt;/&lt;body&gt;
             * khi lưu, còn PageRenderer tự dựng khung tài liệu. Dữ liệu cũ vẫn có thể sót khung —
             * bóc lấy phần thân để GrapesJS không nuốt mất im lặng, và nói rõ cho người dùng.
             */
            var droppedDocumentFrame = false;
            function bodyFragment(html) {
                if (!html) return '';
                var i = html.search(/<body\b[^>]*>/i);
                if (i < 0) return html;
                var open = html.slice(i).indexOf('>') + i + 1;
                var close = html.toLowerCase().lastIndexOf('</body>');
                droppedDocumentFrame = true;
                return html.slice(open, close > open ? close : undefined);
            }

            function isEmptyHtml(html) {
                if (!html || !html.trim()) return true;
                if (/data-nc-block/i.test(html)) return false;
                if (/<(img|svg|iframe|video|audio|canvas|input|hr|picture|source)\b/i.test(html)) return false;
                var tmp = document.createElement('div');
                tmp.innerHTML = html;
                return !(tmp.textContent || '').trim();
            }

            /** Mốc ncTailwind chèn giữa utility đã build và CSS của Style Manager. */
            var SM_MARKER = '/* Style Manager */';
            function manualCssPart(css) {
                if (!css) return '';
                var i = css.indexOf(SM_MARKER);
                if (i >= 0) return css.slice(i + SM_MARKER.length).trim();
                if (/tailwindcss|@@layer\s+(properties|theme|base)|\*,\s*::?before/i.test(css)) return '';
                return css.trim();
            }

            async function loadLayout() {
                try {
                    var res = await fetch(API, { headers: apiHeaders(false), credentials: 'include' });
                    if (!res.ok) return null;
                    var data = await res.json();
                    if (window.ncBuilder) ncBuilder.setCode(data.customCss || '', data.customJs || '');
                    hadContentOnLoad = !isEmptyHtml(data.compiledHtml);
                    return data;
                } catch (e) {
                    console.error('Load failed:', e);
                    return null;
                }
            }

            /** Ưu tiên BuilderJson (giữ nguyên cây component); thiếu thì parse từ CompiledHtml. */
            function loadCanvas(data) {
                if (!data) return false;

                var project = null;
                if (data.builderJson) {
                    try { project = JSON.parse(data.builderJson); } catch (e) { project = null; }
                }
                if (project && project.pages && project.pages.length > 0) {
                    editor.loadProjectData(project);
                    return true;
                }

                if (isEmptyHtml(data.compiledHtml)) return false;

                editor.setComponents(bodyFragment(data.compiledHtml));
                var manual = manualCssPart(data.compiledCss);
                if (manual) editor.setStyle(manual);
                return true;
            }

            // ── Lưu ──────────────────────────────────────────────────────────
            var dirty = false;
            // Mốc dirty count của GrapesJS tại lần nạp/lần lưu gần nhất: chỉ thay đổi VƯỢT mốc
            // này mới tính là chỉnh sửa thật (GrapesJS tự phát vài tick sau load lẫn sau lưu).
            var dirtyBaseline = 0;
            function markDirty() {
                dirty = true;
                setStatus('saving', 'Có thay đổi chưa lưu');
            }

            // Hỏi lại trước khi rời trang CHỈ khi thật sự còn thay đổi chưa lưu (dirty về false
            // ngay khi saveShell thành công). Thay cho noticeOnUnload của GrapesJS — xem trên.
            window.addEventListener('beforeunload', function (e) {
                if (!dirty) return;
                e.preventDefault();
                e.returnValue = '';
            });

            /** Số phần tử data-nc-body trong HTML sắp lưu. 1 là đúng; 0 làm hỏng mọi trang. */
            function markerCount(html) {
                return (html.match(/data-nc-body/gi) || []).length;
            }

            async function saveShell(projectData) {
                var html = editor.getHtml();

                if (hadContentOnLoad && isEmptyHtml(html)) {
                    setStatus('error', 'Canvas đang trống nhưng shell có nội dung — không lưu. Hãy tải lại trang.');
                    return false;
                }

                var markers = markerCount(html);
                if (markers === 0) {
                    setStatus('error', 'Thiếu "Vùng nội dung trang" — kéo khối đó vào shell rồi lưu lại.');
                    return false;
                }
                if (markers > 1 && !confirm(
                    'Shell đang có ' + markers + ' "Vùng nội dung trang". Khi render chỉ vùng ĐẦU TIÊN nhận '
                    + 'nội dung, các vùng còn lại sẽ rỗng. Vẫn lưu?')) return false;

                setStatus('saving', 'Đang lưu…');

                // Cùng đường với Edit.cshtml: compile Tailwind một lần ở đây để trang public không
                // phải build ở runtime.
                var css = window.ncTailwind
                    ? await window.ncTailwind.getCompiledCss(editor)
                    : editor.getCss();

                var code = window.ncBuilder ? ncBuilder.getCode() : { customCss: '', customJs: '' };

                var payload = {
                    key: LAYOUT_KEY,
                    name: LAYOUT_NAME,
                    kind: LAYOUT_KIND,
                    builderJson: JSON.stringify(projectData),
                    compiledHtml: html,
                    compiledCss: css,
                    customCss: (code.customCss && code.customCss.trim()) ? code.customCss : null,
                    customJs: code.customJs || null,
                    isDefault: IS_DEFAULT
                };

                try {
                    var res = await fetch(API, {
                        method: 'PUT',
                        headers: apiHeaders(true),
                        credentials: 'include',
                        body: JSON.stringify(payload)
                    });
                    if (!res.ok) {
                        var err = await res.json().catch(function () { return { error: 'Lỗi không rõ' }; });
                        setStatus('error', err.error || 'Lưu thất bại');
                        return false;
                    }
                    dirty = false;
                    dirtyBaseline = editor.getDirtyCount();
                    setStatus('saved', 'Đã lưu — áp ngay cho các trang dùng shell này');
                    return true;
                } catch (e) {
                    setStatus('error', 'Lưu thất bại: ' + e.message);
                    return false;
                }
            }

            // ── GrapesJS ─────────────────────────────────────────────────────
            var editor = grapesjs.init({
                container: '#gjs',
                height: 'calc(100vh - 48px)',
                width: 'auto',
                fromElement: false,
                showOffsets: true,
                // Tắt notice mặc định của GrapesJS: nó báo rời trang dựa trên dirty count nội bộ,
                // mà count này KHÔNG về 0 khi ta lưu qua API riêng → lưu xong vẫn bị hỏi lại.
                // Cảnh báo rời trang do ta tự gắn bên dưới, chỉ khi còn thay đổi chưa lưu.
                noticeOnUnload: false,
                storageManager: { type: 'local', autosave: false, autoload: false },

                assetManager: {
                    upload: '/admin/Media/Upload',
                    uploadName: 'file',
                    headers: { 'RequestVerificationToken': TOKEN },
                    multiUpload: true,
                    autoAdd: false,
                    embedAsBase64: false,
                    assets: [],
                    uploadFile: function (e, clb) { ncCanvas.uploadFile(e, clb, this); },
                    handleAdd: function (url) { ncCanvas.assets.prepend([ncCanvas.assets.fromUrl(url)]); }
                },

                deviceManager: {
                    devices: [
                        { name: 'Desktop', width: '' },
                        { name: 'Tablet', width: '768px', widthMedia: '768px' },
                        { name: 'Mobile', width: '375px', widthMedia: '375px' }
                    ]
                },

                styleManager: {
                    sectors: [
                        { name: 'Bố cục', open: true, properties: [
                            'display', 'position',
                            { property: 'top' }, { property: 'right' }, { property: 'bottom' }, { property: 'left' },
                            'flex-direction', 'flex-wrap', 'justify-content', 'align-items', 'align-content', 'gap',
                            'flex-grow', 'flex-shrink', 'flex-basis', 'order',
                            'grid-template-columns', 'grid-template-rows', 'grid-gap',
                            'overflow', 'z-index'
                        ] },
                        { name: 'Kích thước', properties: ['width','height','max-width','min-width','max-height','min-height'] },
                        { name: 'Khoảng cách', properties: ['margin','padding'] },
                        { name: 'Chữ', properties: [
                            { property: 'font-family', name: 'Font family', type: 'select', default: '',
                              options: ncCanvas.fontFamilyOptions(GOOGLE_FONTS) },
                            'font-size','font-weight','color','text-align','text-transform','line-height','letter-spacing','text-decoration'] },
                        { name: 'Trang trí', properties: ['background-color','background-image','background-size','background-position','background-repeat','border','border-width','border-radius','box-shadow','opacity'] },
                        { name: 'Hiệu ứng', properties: ['transition','transform','cursor'] }
                    ]
                },

                // Cùng bộ CSS và cùng THỨ TỰ như PageRenderer.BuildHtml.
                canvas: { styles: ['/css/site-utilities.css', TOKEN_CSS_URL, '/css/nc-builder.css'] },

                // Vùng nội dung trang rỗng trong builder (nội dung thật do từng trang cung cấp) nên
                // phải vẽ chỗ giữ chỗ, nếu không header và footer dính liền nhau và người dùng
                // tưởng shell hỏng.
                //
                // canvasCss, KHÔNG phải protectedCss: editor.getCss() luôn ghép protectedCss vào
                // đầu kết quả (trừ khi truyền avoidProtected), mà nc-tailwind.getCompiledCss gọi
                // getCss() không tham số — nên đặt ở protectedCss là nhãn chỗ-giữ-chỗ đi thẳng vào
                // CompiledCss rồi hiện khung gạch chéo "Nội dung của từng trang…" trên trang public.
                // canvasCss chỉ được nhồi vào <style> của iframe canvas, không bao giờ vào getCss().
                canvasCss:
                    '[data-nc-body]{min-height:240px;display:block;' +
                    'border:2px dashed rgba(37,99,235,.45);border-radius:8px;' +
                    'background:repeating-linear-gradient(45deg,rgba(37,99,235,.04) 0 12px,transparent 12px 24px)}' +
                    '[data-nc-body]::after{content:"Nội dung của từng trang hiển thị ở đây";' +
                    'display:flex;align-items:center;justify-content:center;min-height:240px;' +
                    'font:600 13px system-ui,sans-serif;color:#2563eb;opacity:.75}',

                selectorManager: { componentFirst: true }
            });

            if (window.ncTailwind) window.ncTailwind.attach(editor, { tokenCssUrl: TOKEN_CSS_URL });

            // ── Vùng nội dung trang là một component type riêng ───────────────
            // Xoá nhầm nó = mọi trang mất phần thân (PageRenderer rơi về nhánh "nối vào cuối
            // body"), nên khoá removable. droppable:false vì mọi thứ đặt bên trong sẽ bị
            // ReplaceMarkerContent ghi đè lúc render — thà chặn còn hơn để người dùng mất công.
            editor.DomComponents.addType('nc-body', {
                isComponent: function (el) {
                    if (el.getAttribute && el.getAttribute(BODY_MARKER) !== null) return { type: 'nc-body' };
                },
                model: {
                    defaults: {
                        tagName: 'main',
                        name: 'Vùng nội dung trang',
                        attributes: { 'data-nc-body': '' },
                        removable: false,
                        copyable: false,
                        droppable: false,
                        editable: false,
                        components: []
                    }
                }
            });

            // ── Panel nút thao tác (giống Edit.cshtml) ────────────────────────
            (function addToolbarButtons() {
                var opts = editor.Panels.getPanel('options');
                if (!opts) return;
                var btns = opts.get('buttons');
                var have = {};
                btns.forEach(function (b) { have[b.id] = true; });
                [
                    { id: 'sw-visibility', command: 'sw-visibility', className: 'fa fa-square-o', attributes: { title: 'Bật/tắt khung viền' }, context: 'sw-visibility' },
                    { id: 'core-undo', command: 'core:undo', className: 'fa fa-undo', attributes: { title: 'Hoàn tác (Ctrl+Z)' } },
                    { id: 'core-redo', command: 'core:redo', className: 'fa fa-repeat', attributes: { title: 'Làm lại (Ctrl+Shift+Z)' } },
                    { id: 'export-template', command: 'export-template', className: 'fa fa-code', attributes: { title: 'Xem HTML/CSS' }, context: 'export-template' },
                    { id: 'fullscreen', command: 'fullscreen', className: 'fa fa-arrows-alt', attributes: { title: 'Toàn màn hình' } }
                ].forEach(function (b) { if (!have[b.id]) btns.add(b); });
            })();

            async function loadBlockCatalog() {
                try {
                    var res = await fetch('/admin/api/builder/blocks', { headers: apiHeaders(false), credentials: 'include' });
                    if (!res.ok) return null;
                    var data = await res.json();
                    return { blocks: data.blocks || [], sitePresets: data.sitePresets || [] };
                } catch (e) {
                    return null; // null = gọi lỗi; [] = site thật sự không có khối động nào.
                }
            }

            // Đăng ký extension TRƯỚC load để type nhận diện data-nc-block áp dụng ngay lúc parse.
            loadLayout().then(function (data) {
                return loadBlockCatalog().then(function (catalog) {
                    if (window.ncBuilder) {
                        ncBuilder.register(editor, {
                            token: TOKEN,
                            blocks: catalog ? catalog.blocks : [],
                            sitePresets: catalog ? catalog.sitePresets : [],
                            siteCss: SITE_CUSTOM_CSS,
                            hasCodeScope: HAS_CODE_SCOPE,
                            onChange: markDirty
                        });
                    }

                    var loaded = loadCanvas(data);

                    // Khối "Vùng nội dung trang" chỉ xuất hiện khi shell CHƯA có — nếu luôn hiện thì
                    // người dùng dễ kéo vào cái thứ hai, mà chỉ vùng đầu tiên thật sự nhận nội dung.
                    if (markerCount(editor.getHtml()) === 0) addBodySlotBlock();

                    if (catalog === null) setStatus('error', 'Không tải được danh mục khối dữ liệu — hãy tải lại trang.');
                    else if (droppedDocumentFrame) setStatus('saved',
                        'Đã nạp. Phần <head> của shell cũ không sửa ở đây — dùng Site Code (Head HTML).');
                    else if (loaded) setStatus('saved', 'Đã nạp');
                    else if (hadContentOnLoad) setStatus('error', 'Không nạp được shell — đừng lưu, hãy tải lại.');
                    else setStatus('saved', 'Shell trống — kéo khối từ panel bên phải để dựng header/footer');

                    editor.Commands.add('nc-save', { run: function (ed) { saveShell(ed.getProjectData()); } });
                    editor.Keymaps.add('nc-save', '⌘+s, ctrl+s', 'nc-save');

                    // Gắn SAU khi nạp xong để lần load đầu không bị tính là "có thay đổi".
                    // GrapesJS còn phát change:changesCount vài tick sau load (parse xong component,
                    // gán type, thêm block vùng nội dung…) nên phải chờ hết microtask VÀ lấy mốc
                    // dirty count hiện tại — thiếu bước này trang vừa mở đã báo "chưa lưu".
                    setTimeout(function () {
                        dirtyBaseline = editor.getDirtyCount();
                        editor.on('change:changesCount', function () {
                            if (!dirty && editor.getDirtyCount() > dirtyBaseline) markDirty();
                        });
                    }, 0);
                });
            });

            function addBodySlotBlock() {
                editor.BlockManager.add('nc-body-slot', {
                    label: 'Vùng nội dung trang',
                    category: 'Bố cục',
                    attributes: { title: 'Nơi nội dung của từng trang được chèn vào lúc render' },
                    media: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">'
                         + '<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/>'
                         + '<line x1="3" y1="15" x2="21" y2="15"/></svg>',
                    content: { type: 'nc-body' }
                });
            }

            document.getElementById('btn-save').addEventListener('click', function () {
                saveShell(editor.getProjectData());
            });
            // Nút "Code" do nc-builder-extensions.js tự gắn listener sau register().

            document.querySelectorAll('.nc-device').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.nc-device').forEach(function (b) { b.classList.remove('active'); });
                    btn.classList.add('active');
                    editor.setDevice(btn.getAttribute('data-device'));
                });
            });

            window.ncEditor = editor;

            ncCanvas.attach(editor, {
                token: TOKEN,
                siteCss: SITE_CUSTOM_CSS,
                siteHeadHtml: SITE_HEAD_HTML,
                siteJs: SITE_CUSTOM_JS,
                googleFonts: GOOGLE_FONTS
            });
        })();
    </script>
</body>
</html>
