@page
@model NewsCMS.Web.Areas.Admin.Pages.AdVideo.PromptsModel
@{
    ViewData["Title"] = "AdVideo — Prompt";
    ViewData["AdVideoTab"] = "prompts";
}

<partial name="_AdVideoNav" />

@if (Model.LoadError is not null)
{
    <div class="mb-6 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">@Model.LoadError</div>
}

<div class="grid grid-cols-1 gap-6 xl:grid-cols-5">
    <div class="space-y-4 xl:col-span-3">
        @if (Model.Groups.Count == 0)
        {
            <div class="admin-card p-6 text-center text-slate-500">Chưa có prompt nào.</div>
        }
        @foreach (var group in Model.Groups)
        {
            <div class="admin-card overflow-hidden">
                <div class="flex items-center justify-between px-6 pt-5">
                    <div class="font-mono text-sm font-bold text-slate-950">@group.Key</div>
                    <a asp-page="/AdVideo/Prompts" asp-route-code="@group.Key" class="text-xs font-semibold text-indigo-600">Sửa thành bản mới →</a>
                </div>
                <div class="divide-y divide-slate-100">
                    @foreach (var p in group.OrderByDescending(x => x.Version))
                    {
                        <div class="px-6 py-4">
                            <div class="flex items-center justify-between gap-2">
                                <div class="text-sm text-slate-600">
                                    Bản @p.Version · @p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    @if (!string.IsNullOrWhiteSpace(p.ChangeNote))
                                    {
                                        <span class="text-slate-400">— @p.ChangeNote</span>
                                    }
                                </div>
                                @if (p.IsActive)
                                {
                                    <span class="admin-badge bg-emerald-100 text-emerald-700">Đang bật</span>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Activate" asp-route-code="@p.Code" asp-route-version="@p.Version"
                                          data-confirm="Bật @p.Code bản @p.Version? Bản đang bật sẽ tắt.">
                                        <button type="submit" class="admin-btn-secondary">Bật bản này</button>
                                    </form>
                                }
                            </div>
                            <pre class="mt-2 max-h-40 overflow-auto whitespace-pre-wrap rounded-lg bg-slate-50 p-3 text-xs text-slate-700">@p.Content</pre>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <form method="post" asp-page-handler="Add" class="admin-card space-y-4 self-start p-6 xl:col-span-2">
        <h3 class="text-lg font-bold text-slate-950">Thêm phiên bản</h3>
        <div>
            <label class="admin-label" asp-for="Input.Code">Code *</label>
            <input asp-for="Input.Code" class="admin-input mt-1 font-mono" required />
        </div>
        <div>
            <label class="admin-label" asp-for="Input.Kind">Loại *</label>
            <select asp-for="Input.Kind" class="admin-input mt-1">
                @foreach (var k in NewsCMS.Web.Areas.Admin.Pages.AdVideo.PromptsModel.Kinds)
                {
                    <option value="@k.Value">@k.Label</option>
                }
            </select>
        </div>
        <div>
            <label class="admin-label" asp-for="Input.Content">Nội dung *</label>
            <textarea asp-for="Input.Content" rows="10" class="admin-input mt-1 font-mono text-xs" required></textarea>
        </div>
        <div>
            <label class="admin-label" asp-for="Input.ChangeNote">Vì sao đổi *</label>
            <input asp-for="Input.ChangeNote" class="admin-input mt-1" required />
        </div>
        <div>
            <label class="admin-label" asp-for="Input.FormatCode">Mã định dạng</label>
            <input asp-for="Input.FormatCode" class="admin-input mt-1" placeholder="Chỉ cho loại 'Theo định dạng'" />
        </div>
        <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
            <input asp-for="Input.Activate" type="checkbox" class="h-4 w-4" /> Bật ngay
        </label>
        <button type="submit" class="admin-btn-primary">Thêm</button>
    </form>
</div>
