@page
@model CreateModel
@{ ViewData["Title"] = "Thêm người dùng"; }

<div class="mb-6">
    <p class="text-sm font-semibold text-indigo-600">Người dùng</p>
    <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-950">Thêm người dùng mới</h2>
</div>

<form method="post" class="space-y-6">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"></div>

    <div class="admin-card grid gap-5 p-6 md:grid-cols-2">
        <div>
            <label class="admin-label">Email <span class="text-red-500">*</span></label>
            <input asp-for="Input.Email" type="email" class="admin-input" />
            <span asp-validation-for="Input.Email" class="text-xs text-red-500"></span>
        </div>
        <div>
            <label class="admin-label">Họ và tên</label>
            <input asp-for="Input.FullName" class="admin-input" />
        </div>
        <div>
            <label class="admin-label">Mật khẩu <span class="text-red-500">*</span></label>
            <input asp-for="Input.Password" type="password" class="admin-input" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="text-xs text-red-500"></span>
            <p class="mt-1 text-xs text-slate-500">Tối thiểu 8 ký tự, có chữ số và ký tự đặc biệt.</p>
        </div>
        <div>
            <label class="admin-label">Vai trò</label>
            <select asp-for="Input.RoleName" asp-items="Model.RoleOptions" class="admin-select">
                <option value="">-- Chưa gán --</option>
            </select>
        </div>
        <div>
            <label class="admin-label">Site</label>
            <select asp-for="Input.SiteId" asp-items="Model.SiteOptions" class="admin-select">
                <option value="">-- Không thuộc site --</option>
            </select>
        </div>
    </div>

    <div class="flex gap-3">
        <button type="submit" class="admin-btn-primary">Tạo tài khoản</button>
        <a asp-page="/Users/Index" class="admin-btn-secondary">Huỷ</a>
    </div>
</form>
