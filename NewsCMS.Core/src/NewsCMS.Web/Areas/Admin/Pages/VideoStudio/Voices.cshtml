@page
@model NewsCMS.Web.Areas.Admin.Pages.VideoStudio.VoicesModel
@{
    ViewData["Title"] = "Giọng đọc";
    var cloned = Model.Voices.Where(v => v.IsCloned).ToList();
    var presets = Model.Voices.Where(v => !v.IsCloned).ToList();
}

<div class="mb-6 flex items-center justify-between">
    <div>
        <p class="text-sm font-semibold text-indigo-600">Marketing</p>
        <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-950">Giọng đọc</h2>
    </div>
    <a asp-area="Admin" asp-page="/VideoStudio/Index" class="admin-btn-secondary">Video quảng cáo AI</a>
</div>

@if (!Model.IsLinked)
{
    <div class="admin-card p-8 text-center">
        <p class="font-semibold text-slate-950">Site này chưa được bật dịch vụ video AI.</p>
    </div>
    return;
}

@if (Model.Error is not null)
{
    <div class="mb-6 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">@Model.Error</div>
}

<div class="grid grid-cols-1 gap-6 xl:grid-cols-5">
    <div class="space-y-6 xl:col-span-3">
        <div class="admin-card p-6">
            <h3 class="font-bold text-slate-950">Giọng riêng của site</h3>
            @if (cloned.Count == 0)
            {
                <p class="mt-2 text-sm text-slate-500">Chưa có giọng clone nào.</p>
            }
            else
            {
                <ul class="mt-3 divide-y divide-slate-100" id="cloned-voices">
                    @foreach (var v in cloned)
                    {
                        <li class="flex flex-wrap items-center gap-3 py-3">
                            <div class="min-w-0 flex-1">
                                <div class="font-semibold text-slate-900">@v.Name</div>
                                <div class="text-xs text-slate-500">@(v.Description ?? "") · tạo @v.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(v.PreviewUrl))
                            {
                                <audio controls preload="none" src="@v.PreviewUrl" class="h-8"></audio>
                            }
                            <form method="post" asp-page-handler="Delete" asp-route-id="@v.Id"
                                  onsubmit="return confirm('Xoá giọng này? Bên engine cũng xoá; không khôi phục được.');">
                                <button type="submit" class="admin-btn-secondary text-red-600">Xoá</button>
                            </form>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="admin-card p-6">
            <h3 class="font-bold text-slate-950">Giọng có sẵn</h3>
            <p class="mt-1 text-xs text-slate-500">Dùng được cho mọi site. Quản trị nền tảng thêm/bớt ở Cấu hình AdVideo → Giọng đọc.</p>
            @if (presets.Count == 0)
            {
                <p class="mt-2 text-sm text-slate-500">Chưa có giọng có sẵn.</p>
            }
            else
            {
                <ul class="mt-3 divide-y divide-slate-100">
                    @foreach (var v in presets)
                    {
                        <li class="flex flex-wrap items-center gap-3 py-3">
                            <div class="min-w-0 flex-1">
                                <div class="font-semibold text-slate-900">@v.Name</div>
                                @if (!string.IsNullOrWhiteSpace(v.Description))
                                {
                                    <div class="text-xs text-slate-500">@v.Description</div>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(v.PreviewUrl))
                            {
                                <audio controls preload="none" src="@v.PreviewUrl" class="h-8"></audio>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <form method="post" asp-page-handler="Clone" enctype="multipart/form-data" class="admin-card space-y-4 p-6 xl:col-span-2" id="clone-form">
        <div>
            <h3 class="font-bold text-slate-950">Clone giọng mới</h3>
            <p class="mt-1 text-xs text-slate-500">
                1–5 file ghi âm (WAV, MP3, M4A, OGG, FLAC, WebM), mỗi file ≤ 10 MB. Tổng 1–3 phút nói tự nhiên,
                một người, phòng yên tĩnh, không nhạc nền cho kết quả tốt nhất.
            </p>
        </div>
        <div asp-validation-summary="All" class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700 empty:hidden"></div>

        <div>
            <label class="admin-label" asp-for="Input.Name">Tên giọng *</label>
            <input asp-for="Input.Name" class="admin-input mt-1" placeholder="Giọng chị Lan — chủ quán" />
        </div>
        <div>
            <label class="admin-label" asp-for="Input.Description">Mô tả</label>
            <input asp-for="Input.Description" class="admin-input mt-1" placeholder="Nữ, Hà Nội, ấm, chậm rãi" />
        </div>
        <div>
            <label class="admin-label" for="Samples">Ghi âm mẫu *</label>
            <input type="file" id="Samples" name="Samples" multiple accept="audio/*,.wav,.mp3,.m4a,.ogg,.flac,.webm" class="admin-input mt-1" />
        </div>
        <div>
            <label class="admin-label" asp-for="Input.ConsentStatement">Lời xác nhận của chủ giọng *</label>
            <textarea asp-for="Input.ConsentStatement" rows="3" class="admin-input mt-1"
                      placeholder="Chị Nguyễn Thị Lan (chủ giọng) đồng ý bằng văn bản ngày 28/09/2026 cho phép dùng giọng làm video quảng cáo của cửa hàng."></textarea>
        </div>
        <label class="flex items-start gap-2 text-sm text-slate-700">
            <input asp-for="Input.ConsentConfirmed" type="checkbox" class="mt-0.5 h-4 w-4" />
            <span>Tôi xác nhận chủ giọng đã đồng ý cho clone và dùng giọng của họ. Lời xác nhận, tài khoản của tôi (<strong>@User.Identity?.Name</strong>) và mẫu ghi âm được lưu làm bằng chứng.</span>
        </label>
        <button type="submit" class="admin-btn-primary w-full" id="clone-submit">Clone giọng</button>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('clone-form')?.addEventListener('submit', function () {
            const b = document.getElementById('clone-submit');
            b.disabled = true;
            b.textContent = 'Đang tải ghi âm và clone…';
        });
    </script>
}
