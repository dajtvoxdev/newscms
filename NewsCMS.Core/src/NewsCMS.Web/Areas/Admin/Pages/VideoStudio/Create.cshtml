@page
@model NewsCMS.Web.Areas.Admin.Pages.VideoStudio.CreateModel
@{
    ViewData["Title"] = "Tạo video quảng cáo AI";
    var canManageVoices = User.IsInRole("SuperAdmin") || User.HasClaim(Permissions.Prefix, Permissions.VideoStudio.ManageVoices);
}

<div class="mb-6 flex items-center justify-between">
    <div>
        <p class="text-sm font-semibold text-indigo-600">Marketing</p>
        <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-950">Tạo video quảng cáo AI</h2>
    </div>
    <a asp-area="Admin" asp-page="/VideoStudio/Index" class="admin-btn-secondary">Quay lại</a>
</div>

@if (!Model.IsLinked)
{
    <div class="admin-card p-8 text-center">
        <p class="font-semibold text-slate-950">Site này chưa được bật dịch vụ video AI.</p>
    </div>
    return;
}

<form method="post" enctype="multipart/form-data" class="grid grid-cols-1 gap-6 xl:grid-cols-5" id="videostudio-form">
    <input type="hidden" asp-for="Input.IdempotencyKey" />

    <div class="admin-card space-y-5 p-6 xl:col-span-3">
        <div asp-validation-summary="All" class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700 empty:hidden"></div>

        <div>
            <label class="admin-label" asp-for="Input.ProductName">Tên sản phẩm</label>
            <input asp-for="Input.ProductName" class="admin-input mt-1" placeholder="Cà phê CHU rang mộc" />
        </div>
        <div>
            <label class="admin-label" asp-for="Input.Prompt">Cảnh quay mong muốn *</label>
            <textarea asp-for="Input.Prompt" rows="3" class="admin-input mt-1" placeholder="Cận cảnh ly cà phê phin trên bàn gỗ, ánh sáng buổi sáng, hơi nước bốc lên."></textarea>
            <p class="mt-1 text-xs text-slate-500">Viết bằng tiếng Việt thường, như đang tả cho người quay phim. Không cần từ kỹ thuật.</p>
        </div>
        <div>
            <label class="admin-label" asp-for="Input.Script">Lời thoại *</label>
            <textarea asp-for="Input.Script" rows="4" class="admin-input mt-1" placeholder="Cà phê CHU rang mộc từ hạt Arabica Cầu Đất…"></textarea>
            <p class="mt-1 text-xs text-slate-500">Giọng đọc đọc đúng đoạn này; video dài theo lời thoại. Tránh "số 1", "tốt nhất" — cụm quảng cáo tuyệt đối dễ vi phạm.</p>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            <div>
                <label class="admin-label" asp-for="Input.AspectRatio">Khung hình</label>
                <select asp-for="Input.AspectRatio" class="admin-input mt-1">
                    <option value="9:16">Dọc 9:16 (Reels, TikTok)</option>
                    <option value="1:1">Vuông 1:1</option>
                    <option value="16:9">Ngang 16:9</option>
                </select>
            </div>
            <div>
                <label class="admin-label" asp-for="Input.Quality">Chất lượng</label>
                <select asp-for="Input.Quality" class="admin-input mt-1">
                    <option value="standard">Thành phẩm</option>
                    <option value="draft">Nháp (nhanh, rẻ)</option>
                </select>
            </div>
            <div>
                <label class="admin-label" asp-for="Input.DurationSeconds">Thời lượng (giây)</label>
                <input asp-for="Input.DurationSeconds" type="number" min="6" max="180" class="admin-input mt-1" />
            </div>
        </div>
        <div>
            <div class="flex items-center justify-between">
                <div class="admin-label">Giọng đọc</div>
                @if (canManageVoices)
                {
                    <a asp-page="/VideoStudio/Voices" class="text-xs font-semibold text-indigo-600 hover:underline">Clone giọng riêng →</a>
                }
            </div>
            <div class="mt-2 space-y-2" id="voice-picker">
                <label class="flex cursor-pointer items-center gap-3 rounded-xl px-3 py-2 ring-1 ring-slate-200 has-[:checked]:ring-2 has-[:checked]:ring-indigo-600">
                    <input type="radio" name="Input.VoiceId" value="" class="h-4 w-4" @(Model.Input.VoiceId is null ? "checked" : null) />
                    <span class="text-sm font-semibold text-slate-800">Mặc định</span>
                    <span class="text-xs text-slate-500">hệ thống tự chọn theo chất lượng</span>
                </label>
                @foreach (var v in Model.Voices)
                {
                    <label class="flex cursor-pointer flex-wrap items-center gap-3 rounded-xl px-3 py-2 ring-1 ring-slate-200 has-[:checked]:ring-2 has-[:checked]:ring-indigo-600">
                        <input type="radio" name="Input.VoiceId" value="@v.Id" class="h-4 w-4" @(Model.Input.VoiceId == v.Id ? "checked" : null) />
                        <span class="text-sm font-semibold text-slate-800">@v.Name</span>
                        @if (v.IsCloned)
                        {
                            <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-700">giọng riêng</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(v.Description))
                        {
                            <span class="text-xs text-slate-500">@v.Description</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(v.PreviewUrl))
                        {
                            <audio controls preload="none" src="@v.PreviewUrl" class="ml-auto h-8 max-w-full"></audio>
                        }
                    </label>
                }
            </div>
            @if (Model.VoicesError is not null)
            {
                <p class="mt-1 text-xs text-amber-700">Không tải được danh sách giọng (@Model.VoicesError). Video vẫn tạo được bằng giọng mặc định.</p>
            }
        </div>
        <div class="flex flex-wrap gap-6">
            <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
                <input asp-for="Input.HasPerson" type="checkbox" class="h-4 w-4" /> Có người xuất hiện
            </label>
            <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
                <input asp-for="Input.KeepSoundEffects" type="checkbox" class="h-4 w-4" /> Giữ tiếng động gốc
            </label>
        </div>
    </div>

    <div class="admin-card space-y-5 p-6 xl:col-span-2">
        <div>
            <h3 class="font-bold text-slate-950">Ảnh sản phẩm *</h3>
            <p class="mt-1 text-xs text-slate-500">JPEG, PNG hoặc WebP, tối đa 10 ảnh, mỗi ảnh ≤ 15 MB. Ảnh thật của sản phẩm cho kết quả tốt hơn ảnh stock.</p>
        </div>
        <input type="file" name="Images" multiple accept="image/jpeg,image/png,image/webp" class="admin-input" />

        @if (Model.Library.Count > 0)
        {
            <div>
                <div class="admin-label">Hoặc chọn từ thư viện media</div>
                <div class="mt-2 grid grid-cols-3 gap-2 sm:grid-cols-4">
                    @foreach (var img in Model.Library)
                    {
                        <label class="relative block cursor-pointer overflow-hidden rounded-lg ring-1 ring-slate-200 has-[:checked]:ring-2 has-[:checked]:ring-indigo-600">
                            <input type="checkbox" name="Input.LibraryMediaIds" value="@img.MediaId" class="absolute left-1.5 top-1.5 h-4 w-4"
                                   @(Model.Input.LibraryMediaIds.Contains(img.MediaId) ? "checked" : null) />
                            <img src="@img.Url" alt="@(img.Title ?? img.FileName)" title="@(img.Title ?? img.FileName)" loading="lazy" class="aspect-square w-full overflow-hidden bg-slate-100 object-cover text-[0px]" />
                        </label>
                    }
                </div>
            </div>
        }

        <button type="submit" class="admin-btn-primary w-full" id="videostudio-submit">Tạo video</button>
        <p class="text-xs text-slate-500">Dựng mất vài phút. Bấm một lần — gửi lại cùng form không tạo video thứ hai.</p>
    </div>
</form>

@section Scripts {
    <script>
        document.getElementById('videostudio-form')?.addEventListener('submit', function () {
            const b = document.getElementById('videostudio-submit');
            b.disabled = true;
            b.textContent = 'Đang tải ảnh và gửi…';
        });
    </script>
}
