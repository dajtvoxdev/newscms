@page
@model NewsCMS.Web.Areas.Admin.Pages.Sites.CreateFromTemplateModel
@{
    ViewData["Title"] = "Tạo site từ mẫu";
}

<div class="max-w-3xl">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-indigo-600">Hệ thống</p>
    <h2 class="text-xl font-bold text-slate-900 mt-1 mb-6">Tạo site mới từ mẫu</h2>

    <p class="mb-6 flex items-start gap-2 rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-800">
        <span class="mt-0.5 shrink-0">@AdminIcon.Svg("rocket")</span>
        <span>Chọn mẫu <span class="text-indigo-400">@AdminIcon.Svg("arrow-right")</span> nhập thông tin <span class="text-indigo-400">@AdminIcon.Svg("arrow-right")</span> site chạy được ngay. <strong>Không rebuild, không redeploy.</strong>
        Admin riêng của site sẽ đăng nhập quản trị được site đó.</span>
    </p>

    <div asp-validation-summary="All" class="hidden"></div>

    <!-- Template cards -->
    <h3 class="mb-3 text-sm font-bold text-slate-700">1. Chọn mẫu site</h3>
    <div class="mb-6 grid gap-3 sm:grid-cols-3">
        @if (!Model.Templates.Any())
        {
            <div class="col-span-full rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">
                Chưa có mẫu site nào. Cần seed SiteTemplate trước.
            </div>
        }
        @foreach (var t in Model.Templates)
        {
            <label class="relative flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition-all hover:border-indigo-400 hover:shadow-md">
                <input type="radio" asp-for="Input.TemplateId" value="@t.Id" class="mt-1 h-4 w-4 text-indigo-600" required />
                <div>
                    <div class="font-bold text-slate-900">@t.Name</div>
                    <div class="text-xs text-slate-500 mt-1">@t.Description</div>
                </div>
            </label>
        }
    </div>

    <!-- Site info -->
    <h3 class="mb-3 text-sm font-bold text-slate-700">2. Thông tin site</h3>
    <form method="post" class="space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        @Html.AntiForgeryToken()
        <div class="grid gap-5 sm:grid-cols-2">
            <div>
                <label asp-for="Input.Name" class="admin-label">Tên site *</label>
                <input asp-for="Input.Name" class="admin-input" required autofocus />
                <span asp-validation-for="Input.Name" class="admin-validation"></span>
            </div>
            <div>
                <label asp-for="Input.Slug" class="admin-label">Slug *</label>
                <input asp-for="Input.Slug" class="admin-input" required pattern="[a-z0-9\-]+" />
                <span asp-validation-for="Input.Slug" class="admin-validation"></span>
            </div>
        </div>
        <div>
            <label asp-for="Input.PrimaryDomain" class="admin-label">Domain chính (tuỳ chọn)</label>
            <input asp-for="Input.PrimaryDomain" class="admin-input" placeholder="example.com" />
            <p class="mt-1 text-xs text-slate-400">Để trống nếu chỉ test qua slug. Trỏ DNS về server và thêm vào hosts nếu muốn chạy ngay.</p>
        </div>

        <h3 class="pt-2 text-sm font-bold text-slate-700">3. Tài khoản admin site</h3>
        <div class="grid gap-5 sm:grid-cols-2">
            <div>
                <label asp-for="Input.AdminFullName" class="admin-label">Họ tên admin *</label>
                <input asp-for="Input.AdminFullName" class="admin-input" required />
                <span asp-validation-for="Input.AdminFullName" class="admin-validation"></span>
            </div>
            <div>
                <label asp-for="Input.AdminUserName" class="admin-label">Username admin *</label>
                <input asp-for="Input.AdminUserName" class="admin-input" required />
                <span asp-validation-for="Input.AdminUserName" class="admin-validation"></span>
            </div>
            <div>
                <label asp-for="Input.AdminEmail" class="admin-label">Email admin *</label>
                <input asp-for="Input.AdminEmail" class="admin-input" required type="email" />
                <span asp-validation-for="Input.AdminEmail" class="admin-validation"></span>
            </div>
            <div>
                <label asp-for="Input.AdminPassword" class="admin-label">Mật khẩu *</label>
                <input asp-for="Input.AdminPassword" class="admin-input" required type="password" />
                <span asp-validation-for="Input.AdminPassword" class="admin-validation"></span>
            </div>
        </div>

        <div class="flex items-center gap-3 pt-2">
            <button type="submit" class="admin-btn-primary inline-flex items-center gap-1.5">@AdminIcon.Svg("rocket") Tạo site</button>
            <a asp-page="/Sites/Index" class="admin-btn-secondary">Huỷ</a>
        </div>
    </form>
</div>
