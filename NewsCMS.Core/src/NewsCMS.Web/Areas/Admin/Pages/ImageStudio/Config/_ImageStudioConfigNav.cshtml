@* Thanh tab chung của khu Cấu hình Xưởng ảnh. Truyền tên trang đang mở qua ViewData["ImageStudioTab"]. *@
@{
    var current = ViewData["ImageStudioTab"] as string ?? "";
    var tabs = new (string Key, string Page, string Label)[]
    {
        ("models", "/ImageStudio/Config/Models", "Model tạo ảnh"),
        ("sites", "/ImageStudio/Config/Sites", "Site & hạn mức"),
    };
}
<div class="mb-6">
    <p class="text-sm font-semibold text-indigo-600">Quản lý nền tảng</p>
    <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-950">Cấu hình Xưởng ảnh AI</h2>
    <p class="mt-1 text-sm text-slate-500">Cấu hình sẵn các model tạo ảnh; người dùng của các site chọn một trong những model đang bật. Key nằm ở trang <a asp-area="Admin" asp-page="/AiConnections/Index" class="font-semibold text-indigo-600 hover:underline">Kết nối AI</a>.</p>
    <nav class="mt-4 flex flex-wrap gap-2">
        @foreach (var tab in tabs)
        {
            <a asp-area="Admin" asp-page="@tab.Page"
               class="rounded-xl px-3 py-2 text-sm font-semibold @(tab.Key == current ? "bg-indigo-600 text-white" : "bg-white text-slate-600 ring-1 ring-slate-200 hover:text-slate-950")">@tab.Label</a>
        }
    </nav>
</div>
