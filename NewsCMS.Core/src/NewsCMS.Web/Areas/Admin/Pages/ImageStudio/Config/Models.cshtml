@page
@model NewsCMS.Web.Areas.Admin.Pages.ImageStudio.Config.ModelsModel
@using NewsCMS.Domain.Entities.ImageStudio
@{
    ViewData["Title"] = "Model tạo ảnh";
    ViewData["ImageStudioTab"] = "models";
}

<partial name="_ImageStudioConfigNav" />

<div class="mb-4 flex items-center justify-between">
    <p class="text-sm text-slate-500">@Model.Models.Count model · @Model.Models.Count(m => m.IsActive) đang bật</p>
    <a asp-page="/ImageStudio/Config/ModelEdit" class="admin-btn-primary">Thêm model</a>
</div>

@Html.AntiForgeryToken()

<div class="admin-card overflow-hidden">
    <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs font-bold uppercase tracking-wide text-slate-500">
            <tr>
                <th class="px-5 py-3">Model</th>
                <th class="hidden px-5 py-3 md:table-cell">Kết nối · model id</th>
                <th class="px-5 py-3">Giá/ảnh</th>
                <th class="px-5 py-3">Trạng thái</th>
                <th class="hidden px-5 py-3 lg:table-cell">Chạy thử gần nhất</th>
                <th class="px-5 py-3"></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            @if (Model.Models.Count == 0)
            {
                <tr>
                    <td colspan="6" class="px-5 py-10 text-center text-slate-500">
                        Chưa có model nào. Tạo một <a asp-page="/AiConnections/Create" class="font-semibold text-indigo-600 hover:underline">kết nối AI</a> chứa API key (ví dụ 9Router: <code>http://localhost:20128/v1</code>), rồi bấm "Thêm model".
                    </td>
                </tr>
            }
            @foreach (var m in Model.Models)
            {
                <tr class="bg-white align-top">
                    <td class="px-5 py-4">
                        <div class="font-semibold text-slate-900">@m.Name</div>
                        @if (!string.IsNullOrEmpty(m.Description))
                        {
                            <div class="mt-0.5 text-xs text-slate-500">@m.Description</div>
                        }
                    </td>
                    <td class="hidden px-5 py-4 text-xs text-slate-600 md:table-cell">
                        <div>@(m.Adapter == ImageProviderAdapter.Fake ? "Provider giả (dev)" : m.ConnectionName ?? "— kết nối đã xoá —")</div>
                        <code class="text-slate-500">@m.ModelId</code>
                    </td>
                    <td class="px-5 py-4 font-mono text-xs text-slate-600">$@m.PricePerImageUsd.ToString("0.####")</td>
                    <td class="px-5 py-4">
                        <div class="flex flex-wrap gap-1">
                            <span class="rounded-full px-2.5 py-1 text-xs font-semibold @(m.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500")">@(m.IsActive ? "Đang bật" : "Tắt")</span>
                            @if (m.IsDefault)
                            {
                                <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700">Mặc định</span>
                            }
                            @if (!m.AdapterAvailable)
                            {
                                <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700">Máy chủ chưa hỗ trợ</span>
                            }
                        </div>
                    </td>
                    <td class="hidden px-5 py-4 text-xs lg:table-cell" data-test-status="@m.Id">
                        @if (m.LastTestedAt is { } tested)
                        {
                            <span class="@(m.LastTestOk == true ? "text-emerald-700" : "text-red-700")">@(m.LastTestOk == true ? "Chạy được" : "Lỗi") · @tested.ToLocalTime().ToString("dd/MM HH:mm")</span>
                            @if (m.LastTestOk == false && !string.IsNullOrEmpty(m.LastTestError))
                            {
                                <div class="mt-0.5 line-clamp-2 text-slate-500">@m.LastTestError</div>
                            }
                        }
                        else
                        {
                            <span class="text-slate-400">Chưa chạy thử</span>
                        }
                    </td>
                    <td class="px-5 py-4">
                        <div class="flex justify-end gap-2">
                            <button type="button" class="admin-btn-secondary whitespace-nowrap" data-test-model="@m.Id" title="Tạo một ảnh thử (tốn phí một ảnh)">Chạy thử</button>
                            <a asp-page="/ImageStudio/Config/ModelEdit" asp-route-id="@m.Id" class="admin-btn-secondary whitespace-nowrap">Sửa</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@m.Id" data-confirm="Xoá model &quot;@m.Name&quot;? Người dùng sẽ không chọn được model này nữa; lịch sử ảnh vẫn giữ.">
                                <button type="submit" class="admin-btn-secondary text-red-600">@AdminIcon.Svg("trash")</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<dialog id="model-test-dialog" class="w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-0 shadow-2xl backdrop:bg-black/50">
    <div class="flex items-center justify-between border-b border-slate-200 px-5 py-3">
        <h3 class="font-bold text-slate-950">Kết quả chạy thử</h3>
        <button type="button" class="inline-flex rounded-xl p-2 text-slate-400 hover:bg-slate-100" onclick="this.closest('dialog').close()">@AdminIcon.Svg("x")</button>
    </div>
    <div class="space-y-3 p-5 text-sm" id="model-test-body"></div>
</dialog>

@section Scripts {
    <script>
        (function () {
            const dialog = document.getElementById('model-test-dialog');
            const body = document.getElementById('model-test-body');
            const token = () => document.querySelector('input[name="__RequestVerificationToken"]').value;

            document.querySelectorAll('[data-test-model]').forEach((btn) => {
                btn.addEventListener('click', async () => {
                    btn.disabled = true;
                    const label = btn.textContent;
                    btn.textContent = 'Đang tạo ảnh…';
                    try {
                        const resp = await fetch('?handler=Test&id=' + encodeURIComponent(btn.dataset.testModel), {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: { 'RequestVerificationToken': token() },
                        });
                        const data = await resp.json().catch(() => ({ ok: false, error: 'Máy chủ lỗi (HTTP ' + resp.status + ').' }));
                        body.replaceChildren();
                        const msg = document.createElement('p');
                        msg.className = data.ok ? 'font-semibold text-emerald-700' : 'font-semibold text-red-700';
                        msg.textContent = data.ok ? 'Model chạy được (' + data.seconds + ' giây).' : (data.error || 'Không chạy được.');
                        body.append(msg);
                        if (data.ok && data.previewUrl) {
                            const img = document.createElement('img');
                            img.src = data.previewUrl;
                            img.alt = 'Ảnh thử';
                            img.className = 'w-full rounded-xl border border-slate-200';
                            body.append(img);
                        }
                        dialog.showModal();
                    } finally {
                        btn.disabled = false;
                        btn.textContent = label;
                    }
                });
            });
            dialog.addEventListener('close', () => window.location.reload());
        })();
    </script>
}
