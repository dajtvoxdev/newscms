@*
    Partial dùng để khởi tạo TinyMCE 7 (Community) trên 1 textarea cụ thể.
    Cách dùng:
        <textarea id="@Model.EditorId" name="..." asp-for="..."></textarea>
        <partial name="_TinyMce" model='new TinyMceOptions { Selector = "#" + Model.EditorId }' />
    Các tham số có thể tuỳ biến qua Model.
*@
@model NewsCMS.Web.Areas.Admin.Shared.TinyMceOptions

<style>
    .tox .tox-menubar,
    .tox .tox-mbtn__select-label,
    .tox .tox-tbtn__select-label,
    .tox .tox-collection__item-label {
        white-space: nowrap;
    }
</style>
<script src="https://cdn.jsdelivr.net/npm/tinymce@7.6.1/tinymce.min.js" referrerpolicy="origin"></script>
<script src="~/tinymce/langs/vi.js" asp-append-version="true"></script>
<script>
    (function () {
        const TMCE_BUILD = 'v2-debug-2026-05-27';
        console.log('[TinyMCE] partial init', TMCE_BUILD);

        const uploadUrl = '@Url.Page("/Media/Upload", new { area = "Admin" })';
        const uploadRemoteUrl = '@Url.Page("/Media/UploadRemote", new { area = "Admin" })';
        const documentTypes = '.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx';
        const mediaTypes = 'video/*,audio/*';
        const videoExtRe = /\.(mp4|webm|ogv|mov|m4v)(?:$|[?#])/i;
        const audioExtRe = /\.(mp3|wav|ogg|m4a|aac|flac)(?:$|[?#])/i;
        console.log('[TinyMCE] uploadUrl =', uploadUrl);

        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function uploadRemoteImage(remoteUrl) {
            return fetch(uploadRemoteUrl, {
                method: 'POST',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getToken()
                },
                body: JSON.stringify({ url: remoteUrl })
            }).then(function (resp) {
                if (!resp.ok) {
                    return resp.json().catch(function () { return { error: 'HTTP ' + resp.status }; }).then(function (j) {
                        throw new Error(j.error || ('HTTP ' + resp.status));
                    });
                }
                return resp.json();
            });
        }

        // Ưu tiên đẩy qua uploadManager (partial _UploadTracker) để file tải lên từ
        // editor cũng hiện thẻ tiến độ ở góc dưới trái như trang Media, dùng chung
        // hàng đợi + giới hạn 3 file song song. Trang nào không có tracker thì rơi
        // về đường upload nội bộ bên dưới.
        function uploadFile(file, progress) {
            if (window.uploadManager && document.getElementById('upload-tracker')) {
                return new Promise(function (resolve, reject) {
                    window.uploadManager.enqueue(file, {
                        onProgress: function (pct, phase) { if (progress) progress(pct, phase); },
                        onDone: function (result) {
                            if (result && typeof result.location === 'string') resolve(result);
                            else reject('Phản hồi upload không hợp lệ');
                        },
                        onError: function (message) { reject(message || 'Upload thất bại'); }
                    });
                });
            }
            return uploadFileDirect(file, progress);
        }

        function uploadFileDirect(file, progress) {
            // File lớn (> 32MB) đi đường tus resumable — chunk + retry + resume,
            // không bị cắt bởi giới hạn body Cloudflare. Kết quả thật nằm ở handler
            // TusStatus (server còn tạo Media row + poster sau khi nhận đủ byte).
            if (file.size > TUS_THRESHOLD && typeof window.tus !== 'undefined' && window.tus.Upload) {
                return uploadFileTus(file, progress);
            }
            return new Promise(function (resolve, reject) {
                const xhr = new XMLHttpRequest();
                xhr.open('POST', uploadUrl);
                xhr.withCredentials = true;

                const token = getToken();
                if (token) xhr.setRequestHeader('RequestVerificationToken', token);

                xhr.upload.onprogress = function (e) {
                    if (progress && e.lengthComputable) progress(e.loaded / e.total * 100);
                };
                xhr.onload = function () {
                    if (xhr.status < 200 || xhr.status >= 300) {
                        reject('Upload thất bại (HTTP ' + xhr.status + ')');
                        return;
                    }

                    try {
                        const json = JSON.parse(xhr.responseText);
                        if (!json || typeof json.location !== 'string') {
                            reject('Phản hồi upload không hợp lệ');
                            return;
                        }
                        resolve(json);
                    } catch (e) {
                        reject('Không đọc được phản hồi upload');
                    }
                };
                xhr.onerror = function () { reject('Upload thất bại'); };

                const fd = new FormData();
                fd.append('file', file, file.name);
                xhr.send(fd);
            });
        }

        const TUS_THRESHOLD = 32 * 1024 * 1024;
        const TUS_CHUNK_SIZE = 64 * 1024 * 1024;
        const TUS_RETRY_DELAYS = [0, 1000, 3000, 5000, 10000, 30000];

        function tusErrorMessage(error) {
            if (error && error.originalResponse) {
                const code = error.originalResponse.getStatus();
                if (code === 401) return 'Phiên đăng nhập đã hết hạn.';
                if (code === 403) return 'Không có quyền tải lên.';
                if (code === 413) return 'File vượt quá dung lượng cho phép.';
                if (code === 400) return 'Loại file không được phép.';
            }
            return 'Upload thất bại';
        }

        function pollTusStatus(tusId, attemptsLeft) {
            return new Promise(function (resolve, reject) {
                fetch('/Admin/Media?handler=TusStatus&tusId=' + encodeURIComponent(tusId), {
                    credentials: 'include',
                    headers: { 'RequestVerificationToken': getToken() }
                }).then(function (r) {
                    if (!r.ok) throw new Error('Lỗi kiểm tra trạng thái (' + r.status + ')');
                    return r.json();
                }).then(function (json) {
                    if (json.status === 'completed') resolve(json);
                    else if (json.status === 'failed') reject(json.error || 'Xử lý thất bại.');
                    else if (attemptsLeft <= 0) reject('Hết thời gian chờ xử lý.');
                    else setTimeout(function () {
                        pollTusStatus(tusId, attemptsLeft - 1).then(resolve, reject);
                    }, 1500);
                }).catch(reject);
            });
        }

        function uploadFileTus(file, progress) {
            return new Promise(function (resolve, reject) {
                const upload = new tus.Upload(file, {
                    endpoint: '/admin/media/tus',
                    chunkSize: TUS_CHUNK_SIZE,
                    retryDelays: TUS_RETRY_DELAYS,
                    metadata: {
                        filename: file.name,
                        filetype: file.type || 'application/octet-stream'
                    },
                    onProgress: function (bytesUploaded, bytesTotal) {
                        if (progress && bytesTotal) progress(bytesUploaded / bytesTotal * 100);
                    },
                    onSuccess: function () {
                        const tusId = (upload.url || '').split('/').filter(Boolean).pop();
                        if (!tusId) { reject('Không xác định được phiên upload.'); return; }
                        progress && progress(100);
                        pollTusStatus(tusId, Math.round(5 * 60 * 1000 / 1500)).then(resolve, reject);
                    },
                    onError: function (error) { reject(tusErrorMessage(error)); }
                });
                upload.start();
            });
        }

        function chooseFile(accept) {
            console.log('[TinyMCE] chooseFile() called, accept=', accept);
            return new Promise(function (resolve) {
                const input = document.createElement('input');
                input.type = 'file';
                input.accept = accept;
                input.tabIndex = -1;
                input.setAttribute('aria-hidden', 'true');
                input.style.position = 'fixed';
                input.style.left = '-9999px';
                input.style.top = '0';
                input.style.width = '1px';
                input.style.height = '1px';
                input.style.opacity = '0';

                // Append to fullscreen container if TinyMCE is in fullscreen mode,
                // otherwise body. Hidden input outside fullscreen element can't receive
                // synthetic click events while a Fullscreen API element is active.
                const host = document.fullscreenElement || document.body;
                host.appendChild(input);

                let done = false;
                const finish = function (file) {
                    if (done) return;
                    done = true;
                    input.remove();
                    resolve(file || null);
                };

                input.addEventListener('change', function () {
                    const f = input.files && input.files[0] ? input.files[0] : null;
                    console.log('[TinyMCE] file picker change:', f && f.name);
                    finish(f);
                }, { once: true });

                // Fires when user cancels the native file picker (Chromium 113+, Firefox 91+).
                // On older browsers the promise simply stays pending until the input is GC'd.
                input.addEventListener('cancel', function () {
                    console.log('[TinyMCE] file picker cancelled');
                    finish(null);
                }, { once: true });

                // Must be invoked synchronously inside the user-gesture handler;
                // wrapping in requestAnimationFrame loses the activation token and
                // some browsers silently block the file dialog.
                try {
                    console.log('[TinyMCE] input.click() about to fire');
                    input.click();
                    console.log('[TinyMCE] input.click() returned');
                } catch (err) {
                    console.error('[TinyMCE] input.click() threw:', err);
                    finish(null);
                }
            });
        }

        function escapeHtml(value) {
            return String(value || '').replace(/[&<>"]/g, function (ch) {
                return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch];
            });
        }

        function isPdf(url) {
            return /\.pdf(?:$|[?#])/i.test(url || '');
        }

        // Ảnh dán từ clipboard đến dưới dạng Blob (không có .name); uploadManager và
        // FormData đều cần tên file nên bọc lại thành File trước khi đẩy đi.
        function ensureNamedFile(blob, fallbackName) {
            if (blob && blob.name) return blob;
            try {
                return new File([blob], fallbackName || 'clipboard.png', {
                    type: blob.type || 'application/octet-stream'
                });
            } catch (e) {
                return blob;
            }
        }

        // ---------- Chỗ giữ "đang tải lên" ngay trong vùng soạn thảo ----------
        // Người dùng thấy vòng quay + phần trăm tại đúng vị trí con trỏ, thay vì
        // editor đứng im cho tới khi file lên xong. Node bị gỡ lúc serialize
        // (sự kiện PreProcess) nên bấm Lưu giữa chừng không lưu nhầm rác.
        function createUploadPlaceholder(editor, fileName) {
            const id = 'nc-upload-' + Math.random().toString(36).slice(2);
            editor.insertContent(
                '<div class="cms-upload-ph" id="' + id + '" contenteditable="false">'
                + '<span class="cms-upload-spinner"></span>'
                + '<span class="cms-upload-name">' + escapeHtml(fileName || 'Tệp') + '</span>'
                + '<span class="cms-upload-pct">Đang tải lên…</span>'
                + '</div>'
            );

            const node = function () { return editor.dom.get(id); };

            return {
                progress: function (pct, phase) {
                    const el = node();
                    if (!el) return;
                    const label = el.querySelector('.cms-upload-pct');
                    if (!label) return;
                    label.textContent = phase === 'processing'
                        ? 'Đang xử lý trên máy chủ…'
                        : 'Đang tải lên… ' + Math.max(0, Math.min(100, Math.round(pct || 0))) + '%';
                },
                replaceWith: function (html) {
                    const el = node();
                    // Người dùng có thể đã xoá chỗ giữ trong lúc chờ — khi đó chèn ở con trỏ.
                    if (!el) { editor.insertContent(html); return; }
                    editor.undoManager.transact(function () {
                        editor.dom.setOuterHTML(el, html);
                    });
                },
                remove: function () {
                    const el = node();
                    if (el) editor.dom.remove(el);
                }
            };
        }

        function documentHtml(file) {
            const url = file.location;
            const name = escapeHtml(file.fileName || 'Tài liệu');
            const safeUrl = escapeHtml(url);

            if (isPdf(url)) {
                return '<figure class="cms-document-preview">'
                    + '<iframe src="' + safeUrl + '" title="' + name + '" loading="lazy" width="100%" height="520"></iframe>'
                    + '<figcaption><a href="' + safeUrl + '" target="_blank" rel="noopener">Tải tài liệu: ' + name + '</a></figcaption>'
                    + '</figure>';
            }

            return '<p><a href="' + safeUrl + '" target="_blank" rel="noopener">Tải tài liệu: ' + name + '</a></p>';
        }

        function mediaMime(file, fallbackName) {
            const url = file.location || '';
            const name = (file.fileName || fallbackName || '').toLowerCase();
            const ext = (url.match(/\.([a-z0-9]+)(?:$|[?#])/i) || name.match(/\.([a-z0-9]+)$/) || [])[1] || '';
            const map = {
                mp4: 'video/mp4', webm: 'video/webm', ogv: 'video/ogg', mov: 'video/quicktime', m4v: 'video/mp4',
                mp3: 'audio/mpeg', wav: 'audio/wav', ogg: 'audio/ogg', m4a: 'audio/mp4', aac: 'audio/aac', flac: 'audio/flac'
            };
            return map[ext] || '';
        }

        function mediaHtml(file, originalName) {
            const url = file.location;
            const safeUrl = escapeHtml(url);
            const name = escapeHtml(file.fileName || originalName || 'media');
            const mime = mediaMime(file, originalName);
            const isVideo = videoExtRe.test(url) || (mime && mime.startsWith('video/'));
            const isAudio = audioExtRe.test(url) || (mime && mime.startsWith('audio/'));
            const typeAttr = mime ? ' type="' + escapeHtml(mime) + '"' : '';

            if (isVideo) {
                // Poster do ffmpeg sinh lúc upload (nếu có) — hiển thị ngay khung hình
                // thay vì màn hình đen trước khi user bấm play.
                const posterAttr = file.posterUrl ? ' poster="' + escapeHtml(file.posterUrl) + '"' : '';
                return '<figure class="cms-media-preview">'
                    + '<video controls preload="metadata" playsinline' + posterAttr + ' style="width:100%;height:auto;max-width:100%;border-radius:12px;">'
                    + '<source src="' + safeUrl + '"' + typeAttr + '>'
                    + 'Trình duyệt không hỗ trợ phát video.'
                    + '</video>'
                    + '</figure>';
            }
            if (isAudio) {
                return '<figure class="cms-media-preview">'
                    + '<audio controls preload="metadata" style="width:100%;">'
                    + '<source src="' + safeUrl + '"' + typeAttr + '>'
                    + 'Trình duyệt không hỗ trợ phát âm thanh.'
                    + '</audio>'
                    + '</figure>';
            }
            return '<p><a href="' + safeUrl + '" target="_blank" rel="noopener">' + name + '</a></p>';
        }

        // Dựng HTML cho 1 item chọn từ thư viện media (MediaListItemDto, camelCase).
        // Dùng lại đúng mediaHtml/documentHtml của luồng upload để ảnh/video chèn từ
        // thư viện và chèn từ máy cho ra markup y hệt nhau.
        function libraryItemHtml(item) {
            const url = item.filePath || '';
            const kind = (item.kind || '').toLowerCase();
            const name = item.title || item.fileName || '';

            if (kind === 'image') {
                return '<img src="' + escapeHtml(url) + '" alt="' + escapeHtml(item.altText || name) + '">';
            }
            if (kind === 'video' || kind === 'audio') {
                return mediaHtml({ location: url, fileName: item.fileName, posterUrl: item.posterUrl }, item.fileName);
            }
            return documentHtml({ location: url, fileName: name });
        }

        // ---------- Plyr trong editor: preview player đẹp, KHÔNG đụng vào bản lưu ----------
        // Video/audio soạn trong iframe TinyMCE mặc định chỉ có controls trình duyệt — xấu,
        // lag, không giống trang chi tiết thật (dùng Plyr). Ta khởi tạo Plyr NGAY TRONG iframe
        // (qua editor.getWin()/getDoc(), không phải window ngoài) vì Plyr thao tác trực tiếp
        // trên document sở hữu phần tử — gọi từ ngoài sẽ không bind đúng element trong iframe.
        //
        // Plyr bọc <video>/<audio> gốc trong nhiều div điều khiển (.plyr__controls,
        // .plyr__poster...). Nếu lưu nguyên DOM đã bọc, bài viết dính rác HTML và có thể mất
        // thuộc tính poster (Plyr tự quản lý poster qua CSS riêng). Để không sai lệch nội dung
        // lưu xuống DB, ta chụp outerHTML GỐC trước khi Plyr chạm vào, nhét base64 vào
        // data-cms-plyr-original, rồi ở PreProcess (chạy mỗi khi editor.getContent() được gọi —
        // Save, Code view, autosave) thay .plyr wrapper bằng đúng markup gốc đã chụp.
        const PLYR_EDITOR_OPTIONS = {
            // iconUrl phải là URL tuyệt đối: Plyr fetch() sprite bằng URL này từ NGAY TRONG
            // iframe, nơi iframe TinyMCE là about:srcdoc (location.origin = "null", host = "")
            // nên URL tương đối sẽ hỏng — build sẵn từ window ngoài rồi truyền vào.
            // ?v= khớp PlyrAssets.Version: đổi URL khi cập nhật Plyr để browser không dùng
            // sprite cũ trong cache (từng gây "player mất hết icon").
            iconUrl: location.origin + '@Url.Content("~/lib/plyr/plyr.svg")' + '?v=384',
            // KHÔNG set ratio: 0 — Plyr coi 0 là tỉ lệ và throw khi metadata video chưa load
            // (videoWidth=0) → control bar không dựng được → mất hết icon. Xem PlyrAssets.ForBody.
            controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'settings', 'fullscreen']
        };

        function b64EncodeUtf8(str) {
            try { return btoa(unescape(encodeURIComponent(str))); } catch (e) { return ''; }
        }
        function b64DecodeUtf8(str) {
            try { return decodeURIComponent(escape(atob(str))); } catch (e) { return ''; }
        }

        // Bọc Plyr quanh mọi <video>/<audio> trong body editor CHƯA được bọc. An toàn gọi lặp
        // lại (no-op nếu không có phần tử mới) — gọi sau mỗi lần chèn media và sau SetContent
        // (undo/redo, dán, AI thay nội dung, mở bài có sẵn để sửa).
        function reinitPlyrIn(editor) {
            const win = editor.getWin ? editor.getWin() : null;
            const PlyrCtor = win && win.Plyr;
            if (!PlyrCtor) return; // script Plyr trong iframe chưa load xong — sẽ tự gọi lại lúc onload
            const body = editor.getBody && editor.getBody();
            if (!body) return;

            Array.prototype.forEach.call(body.querySelectorAll('video, audio'), function (mediaEl) {
                if (mediaEl.closest('.plyr')) return; // đã init

                const originalHtml = mediaEl.outerHTML;
                try {
                    const instance = new PlyrCtor(mediaEl, PLYR_EDITOR_OPTIONS);
                    const container = instance.elements && instance.elements.container;
                    if (container) {
                        container.setAttribute('data-cms-plyr-original', b64EncodeUtf8(originalHtml));
                    }
                } catch (e) {
                    console.warn('[TinyMCE] Plyr init lỗi trong editor, giữ controls mặc định:', e);
                }
            });
        }

        // Nạp script Plyr NGAY TRONG iframe editor (không phải window ngoài) — Plyr phải chạy
        // trong document sở hữu <video>/<audio> thì mới thao tác đúng. content_css đã lo phần
        // CSS; ở đây chỉ còn JS.
        function loadPlyrIntoEditor(editor) {
            const doc = editor.getDoc ? editor.getDoc() : null;
            if (!doc || doc.getElementById('cms-plyr-script')) return;

            const script = doc.createElement('script');
            script.id = 'cms-plyr-script';
            script.src = location.origin + '@Url.Content("~/lib/plyr/plyr.polyfilled.min.js")';
            script.onload = function () {
                if (editor.removed) return;
                reinitPlyrIn(editor);
            };
            doc.head.appendChild(script);
        }

        // ---------- Social media embed parsing ----------
        function youtubeId(url) {
            const m = url.match(/(?:youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([A-Za-z0-9_-]{6,})/i);
            return m ? m[1] : null;
        }
        function vimeoId(url) {
            const m = url.match(/vimeo\.com\/(?:video\/)?(\d+)/i);
            return m ? m[1] : null;
        }
        function tiktokId(url) {
            const m = url.match(/tiktok\.com\/(?:@@[^\/]+\/video\/|v\/|embed\/v2\/)(\d+)/i);
            return m ? m[1] : null;
        }
        function isFacebookUrl(url) {
            return /(?:facebook\.com|fb\.watch)\//i.test(url);
        }

        function embedFrame(src, opts) {
            opts = opts || {};
            const ratio = opts.ratio || '16/9';
            const allow = opts.allow || 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
            return '<div class="cms-embed" style="position:relative;aspect-ratio:' + ratio + ';width:100%;max-width:720px;margin:1rem auto;">'
                + '<iframe src="' + escapeHtml(src) + '" style="position:absolute;inset:0;width:100%;height:100%;border:0;border-radius:12px;" '
                + 'loading="lazy" allow="' + allow + '" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>'
                + '</div>';
        }

        function parseSocialEmbed(url) {
            if (!url) return null;
            url = url.trim();

            const yt = youtubeId(url);
            if (yt) return { provider: 'YouTube', html: embedFrame('https://www.youtube.com/embed/' + yt) };

            const vm = vimeoId(url);
            if (vm) return { provider: 'Vimeo', html: embedFrame('https://player.vimeo.com/video/' + vm) };

            const tk = tiktokId(url);
            if (tk) return { provider: 'TikTok', html: embedFrame('https://www.tiktok.com/embed/v2/' + tk, { ratio: '9/16' }) };

            if (isFacebookUrl(url)) {
                const isVideo = /\/(?:videos?|watch|reel)\//i.test(url) || /fb\.watch/i.test(url);
                const plugin = isVideo ? 'video.php' : 'post.php';
                const src = 'https://www.facebook.com/plugins/' + plugin + '?href=' + encodeURIComponent(url) + '&show_text=true&width=560';
                return { provider: 'Facebook', html: embedFrame(src, { ratio: isVideo ? '16/9' : '3/4' }) };
            }

            return null;
        }

        tinymce.init({
            selector: '@Html.Raw(Model.Selector)',
            language: 'vi',
            language_url: '/tinymce/langs/vi.js',
            license_key: 'gpl',
            height: @Model.Height,
            menubar: 'file edit view insert format tools table',
            plugins: 'preview searchreplace autolink autosave save directionality code visualblocks visualchars fullscreen image link media codesample table charmap pagebreak nonbreaking anchor insertdatetime advlist lists wordcount quickbars emoticons',
            toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | forecolor backcolor | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link uploadImage uploadMedia uploadDocument mediaLibrary embedSocial aiAssist | table codesample | removeformat | preview fullscreen code',
            toolbar_mode: 'wrap',
            contextmenu: 'link image table',
            branding: false,
            promotion: false,
            statusbar: false,
            quickbars_selection_toolbar: 'bold italic | quicklink h2 h3 blockquote',
            quickbars_insert_toolbar: 'quickimage quicktable',
            toolbar_sticky: true,
            image_advtab: true,
            image_caption: true,
            image_uploadtab: true,
            automatic_uploads: true,
            file_picker_types: 'image media file',
            relative_urls: false,
            remove_script_host: true,
            convert_urls: true,
            paste_data_images: true,
            images_upload_url: uploadUrl,
            images_upload_credentials: true,
            images_reuse_filename: true,
            content_style: 'body{font-family:Inter,-apple-system,Segoe UI,Roboto,sans-serif;font-size:15px;line-height:1.6;}img{max-width:100%;height:auto;}video,audio{width:100%;}.cms-document-preview{margin:1.25rem 0;padding:1rem;border:1px solid #e2e8f0;border-radius:16px;background:#f8fafc}.cms-document-preview iframe{width:100%;min-height:520px;border:1px solid #cbd5e1;border-radius:12px;background:white}.cms-document-preview figcaption{margin-top:.75rem;font-size:14px;font-weight:600}.cms-upload-ph{display:flex;align-items:center;gap:10px;margin:1rem 0;padding:12px 16px;border:1px dashed #c7d2fe;border-radius:12px;background:#eef2ff;color:#4338ca;font-size:14px;line-height:1.3;user-select:none}.cms-upload-ph .cms-upload-spinner{flex:none;width:18px;height:18px;border-radius:50%;border:2px solid #c7d2fe;border-top-color:#4f46e5;animation:cms-upload-spin .7s linear infinite}.cms-upload-ph .cms-upload-name{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-weight:600}.cms-upload-ph .cms-upload-pct{flex:none;font-weight:500;color:#6366f1;font-variant-numeric:tabular-nums}@@keyframes cms-upload-spin{to{transform:rotate(360deg)}}',
            // Plyr CSS nạp NGAY TRONG iframe editor để skin controls giống hệt trang chi tiết.
            // URL gốc "/" (root-relative) — iframe TinyMCE dùng src rỗng/about:blank nên kế
            // thừa origin của trang cha, không cần URL tuyệt đối ở đây (khác iconUrl bên dưới,
            // vốn được Plyr fetch qua JS fetch() nên phải tuyệt đối để chắc chắn đúng origin).
            content_css: ['@Url.Content("~/lib/plyr/plyr.css")'],
            table_default_attributes: { class: 'table' },
            codesample_languages: [
                { text: 'C#', value: 'csharp' },
                { text: 'HTML', value: 'markup' },
                { text: 'CSS', value: 'css' },
                { text: 'JS', value: 'javascript' },
                { text: 'SQL', value: 'sql' },
                { text: 'Bash', value: 'bash' },
                { text: 'JSON', value: 'json' }
            ],
            file_picker_callback: function (callback, value, meta) {
                const accept = meta.filetype === 'image' ? 'image/*' : documentTypes;
                chooseFile(accept).then(function (file) {
                    if (!file) return;
                    // Hộp thoại Chèn ảnh/tệp của TinyMCE có sẵn vòng quay riêng khi
                    // đang chờ callback, nên ở đây chỉ cần thẻ tiến độ góc dưới.
                    uploadFile(file).then(function (json) {
                        callback(json.location, { title: json.fileName || file.name, alt: json.fileName || file.name });
                    }).catch(function (message) {
                        window.toast?.error(message);
                    });
                });
            },
            images_upload_handler: function (blobInfo, progress) {
                const file = ensureNamedFile(blobInfo.blob(), blobInfo.filename());
                return uploadFile(file, progress).then(function (json) { return json.location; });
            },
            setup: function (editor) {
                // Chỗ giữ "đang tải lên" chỉ là UI tạm — gỡ khỏi bản serialize để
                // nội dung lưu xuống DB không dính div rác khi người dùng bấm Lưu
                // lúc file còn đang tải.
                editor.on('PreProcess', function (e) {
                    editor.dom.select('.cms-upload-ph', e.node).forEach(function (el) {
                        editor.dom.remove(el);
                    });
                    // Plyr inline SVG sprite thành <div id="sprite-plyr"> ngay trong body editor.
                    // Không gỡ thì TinyMCE serialize luôn vào nội dung bài → lưu DB một div rỗng,
                    // và trang public sau đó bị chặn nạp sprite (Plyr bỏ qua khi id đã tồn tại)
                    // → mất toàn bộ icon player. Đây là nguồn gốc bug "plyr mất icon".
                    editor.dom.select('#sprite-plyr', e.node).forEach(function (el) {
                        editor.dom.remove(el);
                    });
                });

                // Khôi phục markup <video>/<audio> GỐC (đã chụp trước khi Plyr bọc) thay cho
                // wrapper .plyr trong bản serialize — đảm bảo nội dung lưu xuống DB giống hệt
                // mediaHtml()/libraryItemHtml() sinh ra, không phụ thuộc Plyr đã mutate DOM ra
                // sao. Chạy mỗi khi editor.getContent() được gọi: Lưu, Code view, autosave.
                editor.on('PreProcess', function (e) {
                    editor.dom.select('.plyr[data-cms-plyr-original]', e.node).forEach(function (wrapper) {
                        const encoded = wrapper.getAttribute('data-cms-plyr-original');
                        const html = encoded ? b64DecodeUtf8(encoded) : '';
                        if (!html) return; // giải mã lỗi — thà giữ wrapper còn hơn xoá sạch media

                        const temp = editor.dom.create('div');
                        temp.innerHTML = html;
                        const original = temp.firstElementChild;
                        if (original && wrapper.parentNode) {
                            wrapper.parentNode.replaceChild(original, wrapper);
                        }
                    });
                });

                // Khởi tạo Plyr ngay khi iframe editor sẵn sàng (bài mới lẫn bài có sẵn đều
                // chạy qua đây), và tái áp dụng mỗi khi nội dung bị thay hàng loạt (dán, AI
                // sinh nội dung, undo/redo) — SetContent bắn liên tục lúc gõ chữ do TinyMCE nội
                // bộ dùng nó cho nhiều thao tác nhỏ, nên debounce nhẹ để khỏi quét body quá dày.
                editor.on('init', function () {
                    loadPlyrIntoEditor(editor);
                });
                let plyrReinitTimer = null;
                editor.on('SetContent', function () {
                    clearTimeout(plyrReinitTimer);
                    plyrReinitTimer = setTimeout(function () { reinitPlyrIn(editor); }, 150);
                });

                // ---------- Trợ lý AI ----------
                // Một nút duy nhất mở khung trò chuyện (ai-assist.js). Đăng ký ĐỒNG
                // BỘ ngay trong setup (trước khi toolbar render) nên icon luôn hiện;
                // bản cũ đăng ký nút bên trong .then() của fetch skill, và ai-assist.js
                // cũng đăng ký trùng tên nút — bản chạy sau (không icon) ghi đè bản có
                // icon, đó là lý do nút AI từng trống trơn.
                //
                // Các trang nạp ai-assist.js SAU partial này, nên chỉ tra
                // window.AiAssist lúc người dùng bấm, không phải lúc setup.
                const aiTarget = editor.getElement()?.dataset?.aiTarget;
                if (aiTarget) {
                    const AI_TITLE_SELECTOR = '@Model.AiTitleSelector';
                    const AI_EXCERPT_SELECTOR = '@Model.AiExcerptSelector';
                    const AI_CONTENT_TYPE = '@Model.AiContentType';

                    editor.ui.registry.addIcon('nc-ai',
                        '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
                        + '<path d="m12 3-1.9 5.8L4.3 10.7l5.8 1.9L12 18.4l1.9-5.8 5.8-1.9-5.8-1.9Z"/>'
                        + '<path d="M5 3v3"/><path d="M3.5 4.5h3"/><path d="M18 16v3"/><path d="M16.5 17.5h3"/>'
                        + '</svg>');

                    // Ô ngoài editor (tiêu đề, tóm tắt) do trang render nên tra theo
                    // selector truyền vào; bỏ trống thì coi như trang không có ô đó.
                    const findField = function (selector) {
                        if (!selector) return null;
                        try { return document.querySelector(selector); } catch (e) { return null; }
                    };

                    // Ghi giá trị vào ô ngoài editor + phát sự kiện để các script
                    // khác của trang (sinh slug, đếm ký tự…) cập nhật theo.
                    const writeField = function (el, value) {
                        if (!el) return;
                        el.value = value;
                        el.dispatchEvent(new Event('input', { bubbles: true }));
                        el.dispatchEvent(new Event('change', { bubbles: true }));
                    };

                    const openAiChat = function () {
                        const AI = window.AiAssist;
                        if (!AI) {
                            window.toast?.error('Trợ lý AI chưa sẵn sàng trên trang này.');
                            return;
                        }

                        // Khung chat nằm ngoài iframe editor nên vùng chọn bị mất khi
                        // nó mở — đánh dấu lại để nội dung chèn đúng chỗ con trỏ.
                        const bookmark = editor.selection.getBookmark(2, true);

                        AI.openChat({
                            contentType: AI_CONTENT_TYPE,
                            getContext: function () {
                                return {
                                    title: findField(AI_TITLE_SELECTOR)?.value || '',
                                    excerpt: findField(AI_EXCERPT_SELECTOR)?.value || '',
                                    body: editor.getContent({ format: 'text' })
                                };
                            },
                            onApply: function (payload) {
                                if (payload.field === 'body') {
                                    editor.focus();
                                    try { editor.selection.moveToBookmark(bookmark); } catch (e) { /* vị trí cũ đã mất */ }
                                    // setContent thay cả bài: đúng ý người dùng khi bấm
                                    // "Áp dụng" ở phần Nội dung — họ muốn lấy bản AI viết.
                                    editor.setContent(payload.value || '');
                                    editor.undoManager.add();
                                } else if (payload.field === 'title') {
                                    writeField(findField(AI_TITLE_SELECTOR), payload.value);
                                } else if (payload.field === 'excerpt') {
                                    writeField(findField(AI_EXCERPT_SELECTOR), payload.value);
                                }
                            }
                        });
                    };

                    editor.ui.registry.addButton('aiAssist', {
                        icon: 'nc-ai',
                        tooltip: 'Trợ lý AI — soạn nội dung',
                        onAction: openAiChat
                    });

                    editor.ui.registry.addMenuItem('aiAssist', {
                        icon: 'nc-ai',
                        text: 'Trợ lý AI — soạn nội dung',
                        onAction: openAiChat
                    });
                }

                // Chọn file từ máy -> chèn chỗ giữ có vòng quay -> upload (thẻ tiến độ
                // góc dưới trái) -> thay chỗ giữ bằng nội dung thật.
                const insertFromUpload = function (accept, buildHtml) {
                    chooseFile(accept).then(function (file) {
                        if (!file) return;
                        editor.focus();
                        const placeholder = createUploadPlaceholder(editor, file.name);
                        uploadFile(file, placeholder.progress).then(function (json) {
                            placeholder.replaceWith(buildHtml(json, file));
                            reinitPlyrIn(editor); // no-op nếu không phải video/audio
                        }).catch(function (message) {
                            placeholder.remove();
                            window.toast?.error(message);
                        });
                    });
                };

                const insertUploadedImage = function () {
                    insertFromUpload('image/*', function (json, file) {
                        return '<img src="' + escapeHtml(json.location) + '" alt="' + escapeHtml(json.fileName || file.name) + '">';
                    });
                };

                const insertUploadedDocument = function () {
                    insertFromUpload(documentTypes, function (json) {
                        return documentHtml(json);
                    });
                };

                const insertUploadedMedia = function () {
                    insertFromUpload(mediaTypes, function (json, file) {
                        return mediaHtml(json, file.name);
                    });
                };

                editor.addCommand('QuickbarInsertImage', insertUploadedImage);

                editor.ui.registry.addButton('uploadImage', {
                    icon: 'image',
                    tooltip: 'Tải ảnh từ máy',
                    onAction: insertUploadedImage
                });

                editor.ui.registry.addMenuItem('uploadImage', {
                    icon: 'image',
                    text: 'Tải ảnh từ máy',
                    onAction: insertUploadedImage
                });

                editor.ui.registry.addButton('uploadMedia', {
                    icon: 'embed',
                    tooltip: 'Tải video/audio từ máy',
                    onAction: insertUploadedMedia
                });

                editor.ui.registry.addMenuItem('uploadMedia', {
                    icon: 'embed',
                    text: 'Tải video/audio từ máy',
                    onAction: insertUploadedMedia
                });

                const openEmbedSocialDialog = function () {
                    editor.windowManager.open({
                        title: 'Nhúng nội dung mạng xã hội',
                        body: {
                            type: 'panel',
                            items: [
                                {
                                    type: 'htmlpanel',
                                    html: '<p style="margin:0 0 8px;font-size:13px;color:#475569;">Dán URL từ <strong>YouTube</strong>, <strong>Facebook</strong>, <strong>TikTok</strong>, hoặc <strong>Vimeo</strong>.</p>'
                                },
                                {
                                    type: 'input',
                                    name: 'url',
                                    label: 'URL',
                                    placeholder: 'https://www.youtube.com/watch?v=...'
                                }
                            ]
                        },
                        buttons: [
                            { type: 'cancel', text: 'Hủy' },
                            { type: 'submit', text: 'Chèn', primary: true }
                        ],
                        onSubmit: function (api) {
                            const data = api.getData();
                            const parsed = parseSocialEmbed(data.url);
                            if (!parsed) {
                                editor.notificationManager.open({
                                    text: 'URL không được hỗ trợ. Hỗ trợ: YouTube, Facebook, TikTok, Vimeo.',
                                    type: 'error',
                                    timeout: 4000
                                });
                                return;
                            }
                            editor.insertContent(parsed.html);
                            api.close();
                        }
                    });
                };

                editor.ui.registry.addButton('embedSocial', {
                    icon: 'embed-page',
                    tooltip: 'Nhúng YouTube / Facebook / TikTok',
                    onAction: openEmbedSocialDialog
                });

                editor.ui.registry.addMenuItem('embedSocial', {
                    icon: 'embed-page',
                    text: 'Nhúng mạng xã hội',
                    onAction: openEmbedSocialDialog
                });

                editor.ui.registry.addButton('uploadDocument', {
                    icon: 'new-document',
                    tooltip: 'Tải tài liệu từ máy',
                    onAction: insertUploadedDocument
                });

                editor.ui.registry.addMenuItem('uploadDocument', {
                    icon: 'new-document',
                    text: 'Tải tài liệu từ máy',
                    onAction: insertUploadedDocument
                });

                // ---------- Chèn lại file đã có trong thư viện media ----------
                // width/height là bắt buộc: TinyMCE nhét thẳng chuỗi SVG vào một
                // flex container không ràng buộc kích thước, thiếu hai thuộc tính
                // này thì icon co về 0x0 — nút vẫn bấm được nhưng trông như trống.
                // LƯU Ý: Oxide CSS có quy tắc `.tox-tbtn svg { fill: currentColor }`.
                // CSS thắng presentation attribute, nên fill="none" đặt ở thẻ <svg>
                // bị đè -> path hở của đám mây tự khép kín thành mảng đặc (cục mực
                // như trong ảnh). Chống bằng inline style trên TỪNG path, vì inline
                // style thắng mọi quy tắc stylesheet.
                editor.ui.registry.addIcon('nc-media-library',
                    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
                    // Đám mây + mũi tên xuống (Lucide cloud-download): đọc là "lấy
                    // file từ nơi đã lưu". Mây trơn dễ nhầm với "upload lên cloud",
                    // xung đột ngữ nghĩa với các nút "Tải ... từ máy" kế bên.
                    + '<path style="fill:none" d="M12 13v8"/><path style="fill:none" d="m8 17 4 4 4-4"/>'
                    + '<path style="fill:none" d="M20.42 11.61A6 6 0 0 0 15 4h-.35A6.364 6.364 0 0 0 3.3 7.385 4.146 4.146 0 0 0 4 15.5"/>'
                    + '</svg>');

                const openMediaLibrary = function () {
                    if (!window.mediaLibraryModal?.openPicker) {
                        window.toast?.error('Thư viện media chưa sẵn sàng trên trang này.');
                        return;
                    }
                    // Modal nằm ngoài iframe editor nên vùng chọn bị mất khi nó mở —
                    // đánh dấu lại để file chèn đúng chỗ con trỏ đang đứng.
                    const bookmark = editor.selection.getBookmark(2, true);
                    window.mediaLibraryModal.openPicker({
                        title: 'Chèn từ thư viện media',
                        onSelect: function (item) {
                            editor.focus();
                            try { editor.selection.moveToBookmark(bookmark); } catch (e) { /* vị trí cũ đã mất */ }
                            editor.insertContent(libraryItemHtml(item));
                            reinitPlyrIn(editor); // no-op nếu không phải video/audio
                        }
                    });
                };

                editor.ui.registry.addButton('mediaLibrary', {
                    icon: 'nc-media-library',
                    tooltip: 'Chèn từ thư viện media (file đã tải lên)',
                    onAction: openMediaLibrary
                });

                editor.ui.registry.addMenuItem('mediaLibrary', {
                    icon: 'nc-media-library',
                    text: 'Chèn từ thư viện media',
                    onAction: openMediaLibrary
                });

                // Re-host externally pasted images on our server.
                // Browsers paste images from external pages either as data:/blob: (TinyMCE auto-uploads
                // via images_upload_handler + automatic_uploads) or as <img src="https://other-site/..."/>
                // which TinyMCE keeps untouched. Below we catch the latter case after the paste lands
                // in the editor DOM, swap each external src for a placeholder, then POST the URL to
                // /Admin/Media/UploadRemote and substitute the returned local /uploads/... URL.
                const processRemoteImages = function () {
                    const imgs = editor.dom.select('img');
                    imgs.forEach(function (img) {
                        if (img.hasAttribute('data-cms-remote-done') || img.hasAttribute('data-cms-remote-busy')) return;
                        const src = img.getAttribute('src') || '';
                        if (!src) return;
                        if (src.startsWith('data:')) return;
                        if (src.startsWith('blob:')) return;
                        if (src.startsWith('/uploads/')) return;

                        let parsed;
                        try { parsed = new URL(src, location.href); } catch (e) { return; }
                        if (parsed.origin === location.origin) return;

                        img.setAttribute('data-cms-remote-busy', '1');
                        const originalAlt = img.getAttribute('alt') || '';
                        img.setAttribute('alt', originalAlt + ' (đang tải...)');
                        console.log('[TinyMCE] rehost external img', src);

                        uploadRemoteImage(src).then(function (json) {
                            editor.undoManager.transact(function () {
                                img.setAttribute('src', json.location);
                                // TinyMCE caches the un-converted URL in data-mce-src for its serializer
                                // when convert_urls is on. If we only update src, getContent() will
                                // still emit the original external URL. Update both.
                                img.setAttribute('data-mce-src', json.location);
                                img.setAttribute('alt', originalAlt || json.fileName || '');
                                img.setAttribute('data-cms-remote-done', '1');
                                img.removeAttribute('data-cms-remote-busy');
                            });
                            console.log('[TinyMCE] rehosted ->', json.location);
                        }).catch(function (err) {
                            console.error('[TinyMCE] rehost failed:', src, err);
                            img.setAttribute('alt', originalAlt);
                            img.removeAttribute('data-cms-remote-busy');
                        });
                    });
                };

                editor.on('PastePostProcess', function () {
                    setTimeout(processRemoteImages, 50);
                });
                editor.on('drop', function () {
                    setTimeout(processRemoteImages, 100);
                });

            }
        });
    })();
</script>
