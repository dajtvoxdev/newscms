@model ProductDetailDto
@{
    ViewData["Title"] = $"{Model.Name} — Thế Giới Xe Điện Phú Phúc";
    var gallery = Model.Images.OrderBy(i => i.SortOrder).ToList();
    var mainUrl = Model.ThumbnailUrl ?? gallery.FirstOrDefault()?.Url;
    var specs = new[] {
        ("speed", "Vận tốc tối đa", "70 km/h"),
        ("route", "Quãng đường", "90 km/sạc"),
        ("electric_bolt", "Công suất", "1500W"),
        ("battery_charging_full", "Thời gian sạc", "6 - 8h")
    };
}

<section class="max-w-content mx-auto px-5 lg:px-10 pt-8">
    <nav aria-label="Breadcrumb" class="flex items-center gap-1 text-sm text-secondary">
        <a href="/" class="hover:text-primary">Trang Chủ</a>
        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
        <a href="/san-pham" class="hover:text-primary">Sản Phẩm</a>
        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
        <span class="text-on-surface font-semibold">@Model.Name</span>
    </nav>
</section>

<section class="max-w-content mx-auto px-5 lg:px-10 py-8">
    <div class="grid lg:grid-cols-12 gap-8">
        <!-- GALLERY -->
        <div class="lg:col-span-7 flex flex-col gap-4">
            <div class="bg-surface-lowest rounded-xl p-8 border border-surface-dim shadow-card flex items-center justify-center min-h-[420px] relative overflow-hidden group">
                @if (!string.IsNullOrEmpty(mainUrl))
                {
                    <img id="main-image" src="@mainUrl" alt="@Model.Name" class="max-w-full max-h-[460px] object-contain z-10 transition-transform duration-500 group-hover:scale-105" />
                }
                else
                {
                    <span class="material-symbols-outlined text-7xl text-secondary/40">two_wheeler</span>
                }
                <div class="absolute inset-0 bg-gradient-to-tr from-surface-low to-transparent opacity-50 z-0"></div>
            </div>
            @if (gallery.Count > 0)
            {
                <div class="grid grid-cols-4 gap-3">
                    @foreach (var img in gallery)
                    {
                        <button type="button" onclick="document.getElementById('main-image').src=this.querySelector('img').src"
                                class="bg-surface-lowest rounded-lg p-2 border border-surface-dim hover:border-primary transition-colors h-24 flex items-center justify-center">
                            <img src="@img.Url" alt="@(img.AltText ?? Model.Name)" class="max-h-full object-contain" loading="lazy" />
                        </button>
                    }
                </div>
            }
        </div>

        <!-- DETAILS -->
        <div class="lg:col-span-5 flex flex-col">
            <div class="flex flex-wrap gap-2 mb-4">
                @if (Model.IsFeatured)
                {
                    <span class="bg-primary text-on-primary text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full">Mới</span>
                }
                <span class="bg-surface-highest text-on-surface text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full">Trả góp 0%</span>
                <span class="bg-surface-highest text-on-surface text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full">@Model.CategoryName</span>
            </div>

            <h1 class="font-display font-extrabold text-3xl sm:text-4xl text-on-surface">@Model.Name</h1>

            <div class="mt-3 mb-5">
                @if (Model.SalePrice.HasValue)
                {
                    <span class="font-display font-extrabold text-3xl text-primary">@Model.SalePrice.Value.ToString("N0") đ</span>
                    <span class="text-lg text-secondary line-through ml-3">@Model.Price.ToString("N0") đ</span>
                }
                else
                {
                    <span class="font-display font-extrabold text-3xl text-primary">@Model.Price.ToString("N0") đ</span>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.ShortDescription))
            {
                <p class="text-secondary leading-relaxed mb-7">@Model.ShortDescription</p>
            }

            <!-- SPEC TILES (thông số trưng bày; chi tiết kỹ thuật xem phần mô tả) -->
            <div class="grid grid-cols-2 gap-3 mb-8">
                @foreach (var (icon, label, val) in specs)
                {
                    <div class="bg-surface-container rounded-lg p-4 flex items-center gap-3">
                        <span class="shrink-0 w-10 h-10 rounded-full bg-surface-highest text-primary flex items-center justify-center">
                            <span class="material-symbols-outlined text-[20px]">@icon</span>
                        </span>
                        <div>
                            <p class="text-xs text-secondary">@label</p>
                            <p class="font-display font-bold text-on-surface text-sm">@val</p>
                        </div>
                    </div>
                }
            </div>

            @if (Model.Variants.Any(v => v.IsActive))
            {
                <div class="mb-7">
                    <p class="text-xs font-bold uppercase tracking-wide text-secondary mb-3">Phiên bản</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var v in Model.Variants.Where(x => x.IsActive))
                        {
                            <span class="inline-flex items-center gap-2 rounded-lg border border-surface-dim px-3 py-2 text-sm">
                                <span class="font-semibold text-on-surface">@v.Name</span>
                                @if (v.StockQuantity == 0)
                                {
                                    <span class="text-xs text-primary font-bold">Hết hàng</span>
                                }
                            </span>
                        }
                    </div>
                </div>
            }

            <div class="flex flex-col gap-3 mt-auto">
                <a href="tel:0917171869" class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-primary hover:bg-primary-dark text-on-primary font-display font-bold text-lg py-4 shadow-card-hover transition-colors">
                    <span class="material-symbols-outlined">shopping_cart</span> Mua Ngay
                </a>
                <a href="https://zalo.me/0917171869" target="_blank" rel="noopener" class="w-full inline-flex items-center justify-center gap-2 rounded-xl border-2 border-primary text-primary hover:bg-primary/5 font-bold py-4 transition-colors">
                    <span class="material-symbols-outlined">support_agent</span> Nhận Tư Vấn
                </a>
            </div>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <section class="bg-surface-lowest border-t border-surface-dim mt-8">
        <div class="max-w-content mx-auto px-5 lg:px-10 py-16">
            <h2 class="font-display font-extrabold text-2xl sm:text-3xl text-on-surface mb-6">Chi Tiết Sản Phẩm</h2>
            <article class="prose max-w-none text-on-surface leading-relaxed [&_img]:rounded-xl [&_h2]:font-display [&_h3]:font-display [&_a]:text-primary">
                @Html.Raw(Model.Description)
            </article>
        </div>
    </section>
}
