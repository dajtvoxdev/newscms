<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Tin tức")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/_content/NewsCMS.Theme.Default/css/site.css" />
</head>
<body>
<header class="bg-dark text-white py-3">
    <div class="container d-flex justify-content-between align-items-center">
        <a class="text-white text-decoration-none fs-4 fw-bold" asp-area="Theme" asp-controller="Home" asp-action="Index">NewsCMS</a>
        <nav>
            <a class="text-white me-3" href="#">Trang chủ</a>
            <a class="text-white me-3" href="#">Tin tức</a>
            <a class="text-white me-3" href="#">Liên hệ</a>
        </nav>
    </div>
</header>

<main class="container py-4">
    @RenderBody()
</main>

<footer class="bg-light border-top py-3 mt-5">
    <div class="container text-center text-muted small">
        © @DateTime.Now.Year NewsCMS — Powered by ASP.NET Core
    </div>
</footer>
</body>
</html>
