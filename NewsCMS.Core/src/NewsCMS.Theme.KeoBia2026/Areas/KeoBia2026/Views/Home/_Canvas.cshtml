                    cốc bia (Sao Ma Quỷ)
                </span>
                <span>
                    <strong data-player-history-star-devil-peanut>0</strong>
                    gói lạc (Sao Ma Quỷ)
                </span>
                <span>
                    <strong data-player-history-promo-beer>0</strong>
                    cốc bia khuyến mãi
                </span>
                <span>
                    <strong data-player-history-promo-peanut>0</strong>
                    gói lạc khuyến mãi
                </span>
                <span>
                    <strong data-player-history-quiz-reward-beer>0</strong>
                    cốc bia thưởng quiz
                </span>
                <span>
                    <strong data-player-history-quiz-reward-peanut>0</strong>
                    gói lạc thưởng quiz
                </span>
                <span>
                    <strong data-player-history-quiz-penalty-beer>0</strong>
                    cốc bia do quiz sai
                </span>
                <span>
                    <strong data-player-history-quiz-penalty-peanut>0</strong>
