                </span>
                <span>
                    <strong data-player-history-correct-score-penalty-beer>0</strong>
                    cốc bia do tỉ số sai
                </span>
                <span>
                    <strong data-player-history-correct-score-penalty-peanut>0</strong>
                    gói lạc do tỉ số sai
                </span>
                <span>
                    <strong data-player-history-correct-score-reward-beer>0</strong>
                    cốc bia thưởng tỉ số đúng
                </span>
                <span>
                    <strong data-player-history-correct-score-reward-peanut>0</strong>
                    gói lạc thưởng tỉ số đúng
                </span>
                <span>
                    <strong data-player-history-outstanding-beer>0</strong>
                    cốc bia cũ còn thiếu
                </span>
                <span>
                    <strong data-player-history-outstanding-peanut>0</strong>
                    gói lạc còn thiếu
                </span>
                <span>
                    <strong data-player-history-paid-legacy-beer>0</strong>
                    cốc bia đã rút
                </span>
                <span>
                    <strong data-player-history-paid-peanut>0</strong>
                    gói lạc đã rút
                </span>
            </div>
            <div class="player-history-tabs">
                <button type="button" class="player-history-tab is-active" data-history-tab="bets">Dự đoán</button>
                <button type="button" class="player-history-tab" data-history-tab="cuplogs">Lịch sử cốc bia và gói lạc</button>
            </div>
            <div class="history-list player-history-list" data-player-history-list>
                <div class="history-empty">Bạn chưa có lượt dự đoán nào.</div>
            </div>
            <div class="history-list cuplog-history-list" data-cuplog-history-list style="display:none">
            </div>
        </div>
    </div>

    <div class="modal" data-modal="opta" aria-hidden="true">
        <button type="button" class="modal-backdrop" data-close-modal aria-label="Đóng thống kê Opta"></button>
        <div class="modal-card modal-card--opta">
            <div class="modal-head modal-head--opta">
                <div>
                    <p>Opta Analyst</p>
                    <h3>Thống kê Opta</h3>
                </div>
                <div class="opta-actions">
                    <a class="opta-source-link" href="https://theanalyst.com/competition/fifa-world-cup/predictions" target="_blank" rel="noopener">
                        Mở Opta
                    </a>
                    <button type="button" class="icon-btn" data-close-modal aria-label="Đóng">
                        <span class="material-symbols-rounded">close</span>
                    </button>
                </div>
            </div>
            <div class="opta-frame-wrap">
                <iframe
                    src="https://theanalyst.com/competition/fifa-world-cup/predictions"
                    title="Opta Analyst FIFA World Cup predictions"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox">
                </iframe>
            </div>
            <p class="opta-note">
                Dữ liệu được nhúng trực tiếp từ Opta Analyst. Nếu khung không tải, dùng nút “Mở Opta”.
            </p>
        </div>
    </div>

    <div class="modal" data-modal="unit-transition" aria-hidden="true">
        <button type="button" class="modal-backdrop" data-unit-transition-continue aria-label="Bỏ qua và tiếp tục chơi"></button>
        <div class="modal-card unit-transition-card" role="dialog" aria-modal="true" aria-labelledby="unit-transition-title">
            <div class="unit-transition-visual">
                <span class="unit-transition-beer">🍺</span>
                <span class="material-symbols-rounded">arrow_forward</span>
                <img src="@image("lac.png")" alt="Gói lạc" />
            </div>
            <div class="unit-transition-copy">
                <p class="unit-transition-kicker">Thông báo từ ngày 10/07</p>
                <h3 id="unit-transition-title">Từ vòng tứ kết, phần chơi mới dùng gói lạc</h3>
                <p>Lịch sử cốc bia trước đó vẫn được giữ nguyên. Các kèo từ vòng tứ kết trở đi sẽ tính bằng gói lạc.</p>
                <div class="unit-transition-stop-note">
                    <span class="material-symbols-rounded">front_hand</span>
                    <span>Bạn có thể dừng tại đây. Nếu dừng, tài khoản sẽ không tham gia kèo tiếp theo và không bị tính kèo miss mới.</span>
                </div>
            </div>
            <div class="unit-transition-actions">
                <button type="button" class="unit-transition-stop" data-unit-transition-stop>
                    <span class="material-symbols-rounded">stop_circle</span>
                    Dừng tại đây
                </button>
                <button type="button" class="unit-transition-continue" data-unit-transition-continue>
                    <span class="material-symbols-rounded">sports_soccer</span>
                    Bỏ qua, tiếp tục chơi
                </button>
            </div>
        </div>
    </div>

    <div class="modal" data-modal="profile" aria-hidden="true">
        <button type="button" class="modal-backdrop" data-close-modal aria-label="Đóng hồ sơ"></button>
        <div class="modal-card modal-card--profile">
            <div class="modal-head">
                <div>
                    <p>Chào mừng bạn</p>
                    <h3>Chào mừng bạn vào bàn dự đoán</h3>
                </div>
                <button type="button" class="icon-btn" data-close-modal aria-label="Đóng">
                    <span class="material-symbols-rounded">close</span>
                </button>
            </div>

            <div class="profile-layout">
                <div class="profile-preview">
                    <img src="@image("mascot-cheers.svg")" alt="Avatar người chơi" data-profile-preview />
                </div>
                <div class="profile-form">
                    <label class="field-label" for="player-name">Tên hiển thị</label>
                    <input id="player-name" type="text" maxlength="24" class="field-input" value="MinhBia18" data-player-input />

                    <div class="avatar-upload-panel">
                        <label class="avatar-upload-button" for="avatar-upload">
                            <span class="material-symbols-rounded">upload</span>
                            <span>Tải ảnh đại diện</span>
                        </label>
                        <input id="avatar-upload" type="file" accept="image/*" data-avatar-upload hidden />
                    </div>

                    <div class="cropper-shell" data-cropper-shell hidden>
                        <div class="cropper-frame" data-cropper-frame>
                            <img alt="Ảnh đại diện cần crop" data-cropper-image />
                        </div>
                        <div class="cropper-actions">
                            <button type="button" class="soft-btn" data-cropper-cancel>Đổi ảnh</button>
                            <button type="button" class="primary-btn" data-cropper-apply>Dùng ảnh đã crop</button>
                        </div>
                    </div>

                    <div class="avatar-picker">
                        <button type="button" class="avatar-option" data-avatar-option data-avatar="@image("mascot-cheers.svg")">
                            <img src="@image("mascot-cheers.svg")" alt="Avatar cốc bia cổ vũ" />
                        </button>
                        <button type="button" class="avatar-option" data-avatar-option data-avatar="@image("mascot-analyst.svg")">
                            <img src="@image("mascot-analyst.svg")" alt="Avatar cốc bia phân tích" />
                        </button>
                        <button type="button" class="avatar-option" data-avatar-option data-avatar="@image("mascot-bench.svg")">
                            <img src="@image("mascot-bench.svg")" alt="Avatar cốc bia dự bị" />
                        </button>
                    </div>

                    <div class="tg-verify" data-tg-verify>
                        <div class="tg-verify-head">
                            <span class="material-symbols-rounded">verified_user</span>
                            Xác thực Telegram <em>(bắt buộc để đặt kèo)</em>
                        </div>
                        <div class="tg-status" data-tg-status data-tg-state="none">
                            <span class="material-symbols-rounded">cancel</span>
                            <span data-tg-status-text>Chưa xác thực Telegram</span>
                        </div>
                        @if (telegramOidc)
                        {
                            <div class="tg-login" data-tg-login>
                                <button type="button" class="tg-oidc-btn" data-tg-oidc-login>
                                    <span class="material-symbols-rounded">send</span>
                                    Đăng nhập với Telegram
                                </button>
                            </div>
                        }
                        else if (telegramEnabled)
                        {
                            <div class="tg-login" data-tg-login>
                                <script async src="https://telegram.org/js/telegram-widget.js?22"
                                        data-telegram-login="@telegramBot"
                                        data-size="large"
                                        data-radius="10"
                                        data-onauth="onTelegramAuth(user)"
                                        data-request-access="write"></script>
                            </div>
                            <p class="tg-note" data-tg-login>Mở Telegram, nhắn <strong>@@@telegramBot</strong> hoặc bấm nút trên để đăng nhập. Hệ thống chỉ lấy ID, tên và ảnh đại diện công khai.</p>
                        }
                        else
                        {
                            <p class="tg-note tg-note--warn">Tính năng Telegram chưa được cấu hình (thiếu bot). Liên hệ admin để bật.</p>
                        }
                    </div>

                    <div class="profile-actions">
                        <button type="button" class="primary-btn primary-btn--wide" data-save-profile>
                            <span class="material-symbols-rounded">emoji_events</span>
                            Vào bàn vui
                        </button>
                        <button type="button" class="profile-stop-btn" data-stop-playing hidden>
                            <span class="material-symbols-rounded">stop_circle</span>
                            Tôi muốn dừng lại
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <aside class="analysis-chat" data-analysis-chat hidden aria-live="polite">
        <div class="analysis-head">
            <span class="analysis-icon material-symbols-rounded">psychology</span>
            <div>
                <strong>Phân tích của chuyên gia</strong>
                <span data-analysis-title>Chọn một trận để xem nhanh</span>
            </div>
            <button type="button" class="analysis-close" data-analysis-close aria-label="Đóng phân tích">
                <span class="material-symbols-rounded">close</span>
            </button>
        </div>
        <div class="analysis-body">
            <div class="analysis-message" data-analysis-content></div>
        </div>
        <div class="analysis-foot" data-analysis-notice hidden></div>
    </aside>

    <aside id="community-chat-popup" class="community-chat-popup" data-community-chat hidden aria-live="polite">
        <div class="community-chat-popup__head">
            <div class="community-chat-popup__title">
                <span class="community-chat-popup__head-icon material-symbols-rounded">forum</span>
                <div>
                    <strong>Chat cộng đồng</strong>
                </div>
            </div>
            <button type="button" class="community-chat-popup__close" data-chat-close aria-label="Đóng chat cộng đồng">
                <span class="material-symbols-rounded">close</span>
            </button>
        </div>

        <div class="community-chat-popup__messages" data-chat-list></div>

        <div class="community-chat-popup__seed" hidden>
            @foreach (var item in communityChat)
            {
                <article data-chat-seed-id="@item.Id"
                         data-chat-seed-player-id="@item.PlayerId"
                         data-chat-seed-public-key="@item.PublicKey"
                         data-chat-seed-player-name="@item.PlayerName"
                         data-chat-seed-avatar="@avatar(item.AvatarAsset)"
                         data-chat-seed-message="@item.Message"
                         data-chat-seed-image="@item.ImageUrl"
                         data-chat-seed-time="@item.TimeLabel"
                         data-chat-seed-created-at="@item.CreatedAtIso"></article>
            }
        </div>

        <div class="community-chat-popup__preview" data-chat-image-preview hidden>
            <img src="" alt="Ảnh chat đang chuẩn bị gửi" data-chat-preview-image />
            <div class="community-chat-popup__preview-meta">
                <strong data-chat-preview-name>Ảnh chat</strong>
                <span data-chat-preview-size>Đang chờ gửi</span>
            </div>
            <button type="button" class="community-chat-popup__preview-remove" data-chat-image-remove aria-label="Bỏ ảnh chat">
                <span class="material-symbols-rounded">close</span>
            </button>
        </div>

        <div class="community-chat-popup__emoji" data-chat-emoji-panel hidden>
            @foreach (var emoji in chatEmojis)
            {
                <button type="button" class="community-chat-popup__emoji-btn" data-chat-emoji="@emoji">@emoji</button>
            }
        </div>

        <div class="community-chat-popup__composer">
            <div class="community-chat-popup__toolbar">
                <button type="button" class="community-chat-popup__tool" data-chat-emoji-toggle aria-label="Mở emoji">
                    <span class="material-symbols-rounded">sentiment_satisfied</span>
                </button>
                <label class="community-chat-popup__tool" aria-label="Tải ảnh chat">
                    <span class="material-symbols-rounded">image</span>
                    <input type="file" accept="image/*" data-chat-image-upload hidden />
                </label>
                <span class="community-chat-popup__hint">Tối đa 600 ký tự, kèm 1 ảnh</span>
            </div>

            <textarea class="community-chat-popup__input"
                      rows="2"
                      maxlength="600"
                      placeholder="Nhắn gì đó cho cả bàn vui..."
                      data-chat-input></textarea>

            <div class="community-chat-popup__actions">
                <span class="community-chat-popup__counter" data-chat-counter>0/600</span>
                <button type="button" class="primary-btn" data-chat-send>
                    <span class="material-symbols-rounded">send</span>
                    Gửi
                </button>
            </div>
        </div>
    </aside>
</section>
<footer class="keobia-footer">
    <span>Bia Vui 2026 · @Model.Version</span>
    <span>· Không dùng tiền thật</span>
</footer>
