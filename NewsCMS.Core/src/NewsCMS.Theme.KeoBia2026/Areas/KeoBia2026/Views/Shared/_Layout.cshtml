@{
    var title = ViewData["Title"] as string ?? "Bia Vui 2026";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Bia Vui 2026: dự đoán World Cup 2026." />
    <title>@title</title>
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Nunito:wght@400;600;700;800;900&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,500,1,0" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />
    <link rel="stylesheet" href="~/_content/NewsCMS.Theme.KeoBia2026/css/site.css?v=20260713-unit-summary1" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="keobia-body">
    @RenderBody()
    <div id="heroToastStack" class="hero-toast-stack" aria-live="polite" aria-atomic="false"></div>
    <div id="toastStack" class="toast-stack" aria-live="polite" aria-atomic="false"></div>
    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
    <script src="~/_content/NewsCMS.Theme.KeoBia2026/js/vendor/signalr.min.js?v=8.0.7"></script>
    <script src="~/_content/NewsCMS.Theme.KeoBia2026/js/site.js?v=20260713-unit-summary1"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
